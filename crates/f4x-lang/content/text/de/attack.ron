    "attack.forecast_slightly_weaker": "Der Feind ist etwas stärker.",
    "attack.forecast_even": "Der Feind ist ebenbürtig.",
    "attack.forecast_slightly_stronger": "Du bist etwas stärker.",
    "attack.forecast_much_stronger": "Du bist viel stärker.",
