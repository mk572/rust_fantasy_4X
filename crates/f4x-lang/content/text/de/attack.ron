// Texte des Kastens, der fragt, ob gekämpft wird. Ein Schlüssel steht nur in einer Datei (docs/text.md).
{
    "attack.attacked": "Du wirst angegriffen!",
    "attack.attack": "Angreifen?",
    "attack.fight": "Kämpfen",
    "attack.auto": "Auto",
    "attack.pick_attackers": "Wähle die Angreifer",
    "attack.pick_defenders": "Wähle die Verteidiger",
    "attack.pick_count": "{n} von {max} gewählt",
    "attack.pick_ok": "Kämpfen",
    "attack.mana_title": "Wie viel Mana ausgeben?",
