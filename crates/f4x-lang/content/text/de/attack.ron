// Texte des Kastens, der fragt, ob gekämpft wird. Ein Schlüssel steht nur in einer Datei (docs/text.md).
{
    "attack.attacked": "Du wirst angegriffen!",
    "attack.attack": "Angreifen?",
    "attack.fight": "Kämpfen",
    "attack.auto": "Auto",
    "attack.pick_attackers": "Wähle die Angreifer",
    "attack.pick_defenders": "Wähle die Verteidiger",
    "attack.pick_count": "{n} von {max} gewählt",
    "attack.pick_ok": "Kämpfen",
    "attack.mana_title": "Wie viel Mana ausgeben?",
    "attack.mana_line": "Höchstens so viel deiner {reserve} Mana darf ausgegeben werden:",
    "attack.mana_ok": "Kämpfen",
    "attack.mana_less": "-",
    "attack.mana_more": "+",
    "attack.line_defending": (count: "defenders",
        one: "{by} greift deine einzige Einheit mit {attackers} Einheiten an.",
        other: "{by} greift deine {defenders} Einheiten mit {attackers} Einheiten an."),
    "attack.line_wizard": (count: "defenders",
        one: "{attackers} deiner Einheiten greifen 1 Einheit von {owner} an.",
        other: "{attackers} deiner Einheiten greifen {defenders} Einheiten von {owner} an."),
    "attack.line_monster": (count: "defenders",
        one: "{attackers} deiner Einheiten greifen 1 Monstereinheit an.",
        other: "{attackers} deiner Einheiten greifen {defenders} Monstereinheiten an."),
}
