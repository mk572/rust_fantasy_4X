// Texte der Bildschirme zur Magiererschaffung. Ein Schlüssel steht nur in einer Datei (docs/text.md).
{
    "create.gender_hint": (gender: "wizard",
        masculine: "Tab: er",
        feminine: "Tab: sie",
        neuter: "Tab: es"),
    "create.default_name": "Du",
    "create.pick_race": "Wähle zuerst ein Volk.",
    "create.race_hint": "Zeige auf ein Volk, um darüber zu lesen. Klicke darauf, um es zu wählen, dann auf OK.",
    "create.race.barbarian": "Schlichte Siedler von Arcanus. Ihre Städte wachsen schnell und ihre Truppen werfen Waffen, was zu stetiger Ausdehnung und einfacher Kriegsführung passt. Freundlich zu Nomaden und Orks.",
    "create.race.gnoll": "Ein einfaches Kriegervolk von Arcanus mit den stärksten regulären Truppen der Ebene, aber wenig Raum für späteres Wachstum. Setze auf frühe Eroberung und Plünderung. Leicht zu verstehen.",
    "create.race.halfling": "Freundliche Bauern von Arcanus, die besten im Anbau von Nahrung. Glückliche, zahlreiche Truppen und Schleuderer, die über ihrem Gewicht kämpfen. Fast überall beliebt: ein starker Start.",
    "create.race.high_elf": "Das einzige magische Volk von Arcanus: ein wenig zusätzliche Zauberkraft hilft in den ersten Runden. Langsames Wachstum, teure und zerbrechliche Truppen, kühle Beziehungen außer zu Halblingen, Königlichen und Nomaden.",
    "create.race.high_men": "Ein schlichtes Kriegervolk von Arcanus, dessen Paladine am Ende der religiösen Gebäude sehr stark sind. Ein beliebter Start und ein beliebtes Ziel, freundlich zu vielen Völkern.",
    "create.race.klackon": "Fleißige Insekten von Arcanus. Starke Moral, Einkommen und Produktion, aber nur, wenn die Festungsstadt klackonisch ist. Alles an ihnen ist auf die eigenen Siedlungen ausgelegt.",
    "create.race.lizardman": "Primitive Krieger von Arcanus mit wenig zu bauen, aber billigen, zähen, amphibischen Truppen und schnellem Wachstum. Eine gute Wahl für eine kleine Landmasse. Angespannte Beziehungen zu den meisten Völkern.",
    "create.race.nomad": "Händler von Arcanus mit beweglichen Fernkampfarmeen. Ein langsamer Start: ihr Gold aus Straßen, Flüssen und dem Meer braucht große Städte. Gut gelitten, nach den Halblingen am meisten.",
    "create.race.orc": "Ein schlichtes Allroundvolk von Arcanus ohne Baubeschränkungen und mit billigen Einheiten, wenn auch schwächer als die Königlichen. Ärger mit Zwergen, Klackons und beiden Arten von Elfen.",
    "create.race.beastmen": "Vielseitige Myrraner, die schneller wachsen als der Rest ihrer Ebene und billige, abwechslungsreiche Truppen stellen. Sie decken ab, was die anderen myrranischen Völker nicht können oder bauen.",
    "create.race.dark_elf": "Mächtige myrranische Magier: jeder Bürger bringt einen vollen Punkt Kraft und die Truppen wirken Fernzauber. Sie wachsen langsam, brauchen viele Gebäude und sind fast allen feindlich gesinnt.",
    "create.race.draconian": "Fliegende Myrraner mit Feueratem, eine gute Wahl für kleine Landmassen auf Myrror. Ihre Städte bringen viel Kraft und Reichtum. Unfreundlich zu allen.",
    "create.race.dwarven": "Die reichsten Myrraner: Steuern, Minen, Produktion und Straßen machen sie zum besten Wirtschaftsvolk des Spiels. Schwere Infanterie, später Kanonen und Golems. Sie mögen keine Elfen und Nichtmenschen.",
    "create.race.troll": "Kriegstreiber von Myrror mit enormer Kampfkraft und Regeneration, aber schlechtem Wachstum. Gemacht, um Armeen aufzustellen und Schlachten zu gewinnen. Schlechte Beziehungen zu den anderen Myrranern.",
    "create.select_picture": "Bild wählen",
    "create.select_wizard": "Magier wählen",
    "create.custom": "Eigener",
    "create.wizard_name": "Name des Magiers",
    "create.select_race": "Volk wählen",
    "create.arcanian": "Arcanier:",
    "create.myrran": "Myrraner:",
    "create.need_myrran": "Ein myrranisches Volk kannst du nur wählen, wenn du das Talent Myrraner hast.",
    "create.select_banner": "Banner wählen",
}
