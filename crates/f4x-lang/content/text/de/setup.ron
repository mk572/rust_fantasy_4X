// Texte des Einrichtungsprogramms (`f4x-setup`, docs/installer-design.md). Ein Schlüssel steht nur in einer Datei (docs/text.md).
{
    "setup.title": "Einrichtung von Fantasy 4X",
    "setup.welcome": "Hier werden Bilder, Klänge und Musik von Fantasy 4X aus deiner eigenen Kopie von Master of Magic eingerichtet.\n\nSie werden auf diesem Computer erzeugt und hier gespeichert:\n{folder}\n\nNichts wird hochgeladen oder geteilt. Es dauert einige Minuten.",
    "setup.start": "Weiter",
    "setup.cancel": "Abbrechen",
    "setup.choose_other": "Ordner wählen",
    "setup.choose": "Wähle den Ordner mit deiner Kopie von Master of Magic",
    "setup.ask_folder": "Ordner mit deiner Kopie von Master of Magic (du kannst ihn hierher ziehen): ",
    "setup.no_folder": "Es wurde kein Ordner angegeben.",
    "setup.try_again": "{problem}\n\nEinen anderen Ordner wählen?",
    "setup.err_not_folder": "{path} ist kein Ordner.",
    "setup.err_unreadable": "{path} kann nicht gelesen werden: {why}",
    "setup.err_no_game": "Das sieht nicht nach dem originalen Master of Magic aus: In {path} gibt es kein {file}, und auch nicht in einem Ordner darin. Wähle den Ordner, der die .LBX-Dateien des Spiels enthält.",
    "setup.err_several": "In {path} liegen die Dateien des Spiels mehrfach: {names}. Wähle die gewünschte.",
    "setup.found": "Die Dateien des Spiels wurden in {path} gefunden",
    "setup.complete": "Die Kopie ist vollständig.",
    "setup.names_more": "{names} und {n} weitere",
    "setup.check_missing": (count: "n", one: "Eine Datei des Spiels fehlt in diesem Ordner: {names}.", other: "{n} Dateien des Spiels fehlen in diesem Ordner: {names}."),
    "setup.check_damaged": (count: "n", one: "Eine Datei ist nicht, wie sie sein sollte (abgeschnitten oder eine andere Art von Datei): {names}.", other: "{n} Dateien sind nicht, wie sie sein sollten (abgeschnitten oder eine andere Art von Datei): {names}."),
    "setup.incomplete": "Ist das eine vollständige Kopie des Originalspiels? Es wurde nichts entpackt.",
    "setup.target": "Die Bilder kommen nach {folder}",
    "setup.stage_read": "Die Bilder des Originalspiels werden gelesen. Das dauert einige Minuten.",
    "setup.stage_pack": "Die Bilder werden gepackt.",
    "setup.stage_place": "Die Bilder werden an ihren Platz gelegt.",
    "setup.done": "Fertig: {pictures} Bilder in {packs} Dateien in {folder}",
    "setup.err_link": "{folder} ist eine Verknüpfung zu {target}. Die Einrichtung schreibt nicht hindurch: Entferne die Verknüpfung oder wähle einen anderen Datenordner.",
    "setup.err_failed": "Die Einrichtung wurde abgebrochen: {why}",
    "setup.working": "Bitte warten. Schließe dieses Fenster nicht.",
    "setup.close": "Schließen",
    "setup.usage": "f4x-setup: entpackt die Bilder, Klänge und Musik deiner eigenen Kopie von Master of Magic für das Spiel.\n\nAufruf: f4x-setup [--cli] [--game ORDNER] [--data ORDNER] [--check] [--roms ORDNER | --download-roms | --no-music]\n  --cli        in diesem Terminal fragen und antworten statt in Fenstern\n  --game ORDNER   der Ordner mit deiner Kopie des Originals (wird gefragt, wenn weggelassen)\n  --data ORDNER   wo das Spiel seine Bilder und Spielstände ablegt (Standard: der Ordner deines Benutzers für das Spiel; auf dem Mac ~/Library/Application Support/Fantasy4X)\n  --check      nur prüfen, ob die Kopie vollständig ist; nichts entpacken\n  --roms ORDNER   ein Ordner mit den MT-32-ROM-Dateien, für die Musik\n  --download-roms   die MT-32-ROM-Dateien aus dem Internet Archive laden, für die Musik\n  --no-music   keine Musik erzeugen\nNichts vom Original wird hochgeladen oder anderswohin kopiert als in den Datenordner.",
    "setup.err_option": "Unbekannte Option {option}.",
    "setup.err_value": "{option} braucht einen Ordner.",
    "setup.err_roms_missing": "Diese MT-32-ROM-Dateien fehlen: {names}.",
    "setup.err_roms_wrong": "Diese Dateien sind nicht die MT-32-ROMs, die die Musik braucht (andere Revision oder beschädigt): {names}.",
    "setup.err_roms_failed": "Die MT-32-ROM-Dateien konnten nicht vorbereitet werden: {why}",
    "setup.music_ask": "Die Musik wird auf diesem Computer mit einer Emulation des Klangmoduls Roland MT-32 erzeugt. Dafür braucht sie die beiden ROM-Dateien des Moduls, die urheberrechtlich Roland gehören.\n\nDu kannst sie herunterladen oder Dateien verwenden, die du schon hast.",
    "setup.music_download": "Herunterladen",
    "setup.music_have": "Ich habe sie",
    "setup.music_skip": "Keine Musik",
    "setup.music_confirm": "Diese beiden Dateien ({names}) werden aus dem Internet Archive geladen:\n{page}\nca. {size}.\n\nSie sind urheberrechtlich geschützte Firmware von Roland: Mit dem Download bestätigst du, dass du sie verwenden darfst. Sonst wird nichts gesendet.",
    "setup.choose_roms": "Wähle den Ordner mit den MT-32-ROM-Dateien (mt32_ctrl_2_07.rom und mt32_pcm.rom)",
    "setup.ask_music": "Die Musik braucht die MT-32-ROM-Dateien von Roland. Sie sind urheberrechtlich geschützte Firmware von Roland. Gib d ein, um sie zu laden (ca. {size}, von {page}; damit bestätigst du, dass du sie verwenden darfst), den Pfad eines Ordners, der sie enthält, oder nur Enter für keine Musik: ",
    "setup.stage_effects": "Die Soundeffekte werden erzeugt.",
    "setup.stage_download": "Die MT-32-ROM-Dateien werden geladen: {percent}%",
    "setup.stage_music": "Die Musik wird berechnet: Lied {done} von {total}. Das dauert ein bis zwei Minuten.",
    "setup.done_sounds": (count: "n", one: "Ein Soundeffekt.", other: "{n} Soundeffekte."),
    "setup.done_music": (count: "n", one: "Ein Lied.", other: "{n} Lieder."),
    "setup.done_no_music": "Es wurde keine Musik erzeugt. Starte die Einrichtung erneut, um sie hinzuzufügen.",
    "setup.err_music_failed": "Bilder und Soundeffekte sind vorhanden, aber die Musik konnte nicht erzeugt werden: {why}",
}
