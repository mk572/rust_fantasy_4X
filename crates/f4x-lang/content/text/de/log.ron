// Die Zeilen des Meldungsprotokolls unter der Karte, eine für jedes Ereignis, von dem der Spieler erfährt.
// Ein Schlüssel steht nur in einer Datei (docs/text.md).
{
    "log.founded": "{city} gegründet",
    "log.order_failed": "Befehle bei {x}, {y} abgebrochen, die Einheiten bleiben stehen: {reason}",
    "log.a_rival": "ein Rivale",
    "log.a_hero": "Ein Held",
    "log.items_awarded": (count: "lost",
        zero: "Gegenstände fallen an den Sieger: {items}",
        other: "Gegenstände fallen an den Sieger: {items} ({lost} passten nicht in die Waffenkammer und gehen verloren)"),
    "log.production_complete": "{city}: {item} fertig",
    "log.production_impossible": "{city} kann {item:def_acc} nicht mehr herstellen und wechselt zu Handelsgütern",
    "log.production_blocked": (number: "item", singular: "{city}: {item:Def} ist fertig, kann die Stadt aber noch nicht verlassen (sie ist voll oder zu klein für Siedler)", plural: "{city}: {item:Def} sind fertig, können die Stadt aber noch nicht verlassen (sie ist voll oder zu klein für Siedler)"),
    "log.rift": "Der Chaosriss über {city} schlägt zu",
    "log.rift_units": (count: "units",
        one: "Der Chaosriss über {city} schlägt zu: 1 Einheit vernichtet",
        other: "Der Chaosriss über {city} schlägt zu: {units} Einheiten vernichtet"),
    "log.rift_building": (number: "building", singular: "Der Chaosriss über {city} schlägt zu, {building:def} stürzt ein", plural: "Der Chaosriss über {city} schlägt zu, {building:def} stürzen ein"),
    "log.rift_units_building": (count: "units",
        one: (number: "building", singular: "Der Chaosriss über {city} schlägt zu: 1 Einheit vernichtet, {building:def} stürzt ein", plural: "Der Chaosriss über {city} schlägt zu: 1 Einheit vernichtet, {building:def} stürzen ein"),
        other: (number: "building", singular: "Der Chaosriss über {city} schlägt zu: {units} Einheiten vernichtet, {building:def} stürzt ein", plural: "Der Chaosriss über {city} schlägt zu: {units} Einheiten vernichtet, {building:def} stürzen ein")),
    "log.city_grew": "{city} wächst auf {figures}",
    "log.city_shrank": "{city} schrumpft auf {figures}",
    "log.units_disbanded": (count: "n",
        one: "1 Einheit aufgelöst: unbezahlt oder unversorgt",
        other: "{n} Einheiten aufgelöst: unbezahlt oder unversorgt"),
    "log.unit_crowded_out": "{unit} aufgelöst: zu viele Einheiten auf einem Feld",
    "log.city_looted": "{city} fällt: {gold} Gold geplündert, {citizens} Bürger und {buildings} Gebäude verloren",
    "log.city_looted_yours": "{city} gehört dir: {gold} Gold geplündert, {citizens} Bürger und {buildings} Gebäude verloren",
    "log.city_razed": "Die Stadt wird geschleift: {gold} Gold geplündert",
    "log.city_destroyed": "Eine Stadt wird zerstört",
    "log.raiders": (count: "n",
        one: "{city} hat einen Kämpfer ausgesandt, um die Nachbarn zu erobern",
        other: "{city} hat {n} Kämpfer ausgesandt, um die Nachbarn zu erobern"),
    "log.sea_raid": (count: "n",
        one: "Ein Schiff hat einen Kämpfer und einen Siedler an der Küste abgesetzt",
        other: "Ein Schiff hat {n} Kämpfer und einen Siedler an der Küste abgesetzt"),
    "log.monsters_took_over": (count: "n",
        one: "{site}: Ein Monster hat die Kreaturen vertrieben und sich eingenistet",
        other: "{site}: {n} Monster haben die Kreaturen vertrieben und sich eingenistet"),
    "log.monsters_settled": (count: "n",
        one: "{site}: Ein Monster hat sich eingenistet",
        other: "{site}: {n} Monster haben sich eingenistet"),
    "log.city_rampaged": "Monster haben {city} verwüstet",
    "log.city_rampaged_yours": "Monster haben {city} verwüstet!",
    "log.city_ruined": "Monster haben {city} dem Erdboden gleichgemacht",
    "log.city_ruined_yours": "Monster haben {city} dem Erdboden gleichgemacht! Sie haben sich in den Ruinen eingenistet",
    "log.banished_you": "Deine Festung ist gefallen! Du wirst verbannt und wirkst den Zauber der Rückkehr",
    "log.banished_rival": "Ein rivalisierender Magier wird verbannt",
    "log.returned": "Du bist in deine Festung zurückgekehrt",
    "log.wizard_defeated": "{wizard} ist besiegt",
    "log.fortress_moved": "Die Festung wurde verlegt",
    "log.units_drowned": (count: "n",
        one: "1 Einheit ertrinkt ohne Schiff",
        other: "{n} Einheiten ertrinken ohne Schiff"),
    "log.ship_stranded": (count: "n",
        one: "Ein Schiff wird an Land zerstört; seine 1 Einheit bleibt am Ufer",
        other: "Ein Schiff wird an Land zerstört; seine {n} Einheiten bleiben am Ufer"),
    "log.road_built": "Ein Straßenfeld ist fertig",
    "log.roads_enchanted": "Die Straßen sind verzaubert",
    "log.volcano_raised": "Ein Vulkan erhebt sich",
    "log.node_melded": "Der Geist verschmilzt mit dem Knoten",
    "log.meld_failed": "Der Wächtergeist in diesem Knoten tötet deinen Geist",
    "log.buildings_collapsed": (count: "n",
        one: "1 Gebäude stürzt ein",
        other: "{n} Gebäude stürzen ein"),
    "log.terrain_changed": "Das Land verändert sich",
    "log.circle_moved": "Der Beschwörungskreis wurde verlegt",
    "log.learned": "Du hast {spell:def_acc} gelernt",
    "log.cast": "Du hast {spell:def_acc} gewirkt",
    "log.fizzled_nightshade": (number: "spell", singular: "{spell:Def} verpufft: Nachtschatten schützt {city}", plural: "{spell:Def} verpuffen: Nachtschatten schützt {city}"),
    "log.suppressed": (number: "spell", singular: "{spell:Def} wird durch {counter:def_acc} von {wizard} gestoppt", plural: "{spell:Def} werden durch {counter:def_acc} von {wizard} gestoppt"),
    "log.spell_failed": "{spell} misslingt: {reason} Die {mana} Mana werden zurückerstattet.",
    "log.power_drained": "Kraftentzug nimmt {wizard} {amount} Mana",
    "log.skill_destroyed": "{wizard} verliert {amount} Punkte Zauberfertigkeit für immer",
    "log.units_slain": (count: "n",
        one: "{spell} erschlägt 1 Einheit",
        other: "{spell} erschlägt {n} Einheiten"),
    "log.unit_transformed": "{from} wird zu {to}",
    "log.earthquake": "Das Erdbeben tötet {units} Einheiten und zerstört {buildings} Gebäude",
    "log.mastery_started": "{wizard} hat begonnen, den Zauber der Meisterschaft zu wirken",
    "log.stasis_ended": "Eine Einheit befreit sich aus der Stase",
    "log.unit_mutated": "Die Einheit wird vom Chaos mutiert",
    "log.world_spell_struck": "{spell} tötet {units} Einheiten und {citizens} Bürger und zerstört {buildings} Gebäude",
    "log.spell_blasted": "Zauberstoß beendet {spell:def_acc} von {wizard} ({mana} Mana)",
    "log.global_removed": (number: "spell", singular: "{spell:Def} von {wizard} ist beendet", plural: "{spell:Def} von {wizard} sind beendet"),
    "log.global_taken": "Du hast {spell:def_acc} von {wizard} übernommen",
    "log.dispel_failed": "Das Bannen {spell:def_gen} misslingt",
    "log.dispelled": (count: "n",
        one: "1 Verzauberung gebannt",
        other: "{n} Verzauberungen gebannt"),
    "log.spell_ready": (number: "spell", singular: "{spell:Def} ist bereit: Wähle das Ziel (S öffnet die Auswahl erneut)", plural: "{spell:Def} sind bereit: Wähle das Ziel (S öffnet die Auswahl erneut)"),
    "log.hero_joined": "{hero} schließt sich deiner Armee an",
    "log.hero_spell_failed": (number: "spell", singular: "{spell:Def} findet keinen Helden, der geholt werden könnte", plural: "{spell:Def} finden keinen Helden, der geholt werden könnte"),
    "log.no_effect_yet": (number: "spell", singular: "{spell:Def} hat noch keine Wirkung (nicht umgesetzt)", plural: "{spell:Def} haben noch keine Wirkung (nicht umgesetzt)"),
    "log.lapsed": (number: "spell", singular: "{spell:Def} endete: nicht genug Mana für den Unterhalt", plural: "{spell:Def} endeten: nicht genug Mana für den Unterhalt"),

    "log.loot_gold": "{n} Gold",
    "log.loot_mana": "{n} Mana",
    "log.loot_items": (count: "n", one: "1 magischer Gegenstand", other: "{n} magische Gegenstände"),
    "log.loot_prisoner": "ein Gefangener",
    "log.loot_spell": "ein Zauber",
    "log.loot_book": "ein Zauberbuch ({realm})",
    "log.loot_retort": "ein Talent",
    "log.site_cleared": "Der Ort ist geräumt: {things}",
    "log.site_cleared_empty": "Der Ort ist geräumt",

    "log.saved": "Runde {turn} gespeichert in {path}",
    "log.save_failed": "Speichern fehlgeschlagen: {why}",
    "log.hotkeys_failed": "Deine Tastenbelegung wurde nicht gelesen, die mitgelieferte wird verwendet: {why}",
    "log.save_edited": "Warnung: Dieser Spielstand wurde nach dem Schreiben durch das Spiel bearbeitet und spielt sich möglicherweise anders",
    "log.loaded": "Runde {turn} geladen aus {path}",
    "log.load_failed": "Laden fehlgeschlagen: {why}",
    "log.location_pick_save": "Diesen Ort speichern: 1 bis 8 drücken",
    "log.location_pick_recall": "Zu einem gespeicherten Ort gehen: 1 bis 8 drücken",
    "log.location_saved": "Ort {slot} gespeichert",
    "log.location_empty": "Ort {slot} ist leer",
    "log.nothing_to_find": "Es gibt nichts zu finden",
    "log.undid": "{what} rückgängig gemacht",
    "log.nothing_to_undo": "Nichts rückgängig zu machen (Rundenende, Entdeckungen und Würfel lassen sich nicht rückgängig machen)",
    "log.turn": "Runde {turn}",
    "log.new_map": "Neue Karte, Startwert {seed}",
    "log.crowded": "Nur {n} Felder für jeden Magier: Vielleicht ist kein Platz zum Ausbreiten.",
    "log.map_failed": "Kartenerzeugung fehlgeschlagen: {why}",
    "log.cast_cancelled": "Zauber abgebrochen",
    "log.resign_question": "Es dauert noch mindestens {turns} Runden, bis du zurückkehren darfst. Willst du aufgeben?",
    "log.banished_spells": "Solange du verbannt bist, darfst du keine Zauber wirken. Es dauert noch mindestens {turns} Runden, bis du zurückkehren darfst.",
    "log.banished_diplomacy": "Solange du verbannt bist, darfst du keine anderen Magier kontaktieren.",
    "log.resign_keys": "J: aufgeben      Enter: weiter zaubern",
    "log.farmers_balanced": "Bauern angepasst, um die Armee zu ernähren",
    "log.select_settlers": "Wähle zuerst Siedler",
