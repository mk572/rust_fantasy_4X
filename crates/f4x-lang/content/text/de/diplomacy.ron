// Was die anderen Magier sagen, nach Lage und Stimmung, und die Wörter des Diplomatiebildschirms.
// Ein `pick`-Eintrag hat mehrere Formulierungen; das Salz des Magiers wählt eine.
// Ein Schlüssel steht nur in einer Datei (docs/text.md).
{
    "diplomacy.greeting_cold": (pick: "salt", lines: [
        "So. Du wagst es, vor mich zu treten. Sag, was du willst, und fasse dich kurz.",
        "Ich hatte gehofft, dein Gesicht nie wieder zu sehen. Sprich.",
        "Meine Geduld mit dir ist dünn. Verschwende sie nicht.",
    ]),
    "diplomacy.greeting_wary": (pick: "salt", lines: [
        "Gruß. Ich höre, was du zu sagen hast.",
        "Endlich begegnen wir uns. Was willst du von mir?",
        "Ich habe dich erwartet. Sprich, dann sehen wir weiter.",
    ]),
    "diplomacy.greeting_warm": (pick: "salt", lines: [
        "Willkommen, Freund! Es ist stets eine Freude, mit dir zu sprechen.",
        "Ah, du ehrst mich mit deiner Gesellschaft. Was kann ich für dich tun?",
        "Ein schöner Tag für einen Besuch! Sag mir, was dich beschäftigt.",
    ]),
    "diplomacy.greeting_maniacal": "Du wirst diesen Besuch nicht lange bereuen! Sprich, solange du noch kannst.",
    "diplomacy.greeting_peaceful": "Mir wäre lieber, wir wären keine Feinde. Sag, was du willst.",

    "diplomacy.menu_prompt": "Wie kann ich dir dienen:",
    "diplomacy.propose_prompt": "Du schlägst einen Vertrag vor:",
    "diplomacy.threaten_prompt": "Deine Handlungen:",
    "diplomacy.tribute_prompt": "Was bietest du als Tribut an?",
    "diplomacy.exchange_prompt": "Welche Art von Zauber interessiert dich?",
    "diplomacy.exchange_give_prompt": "Was gibst du dafür?",
    "diplomacy.third_war": "Gegen welchen Magier?",
    "diplomacy.third_break": "Wessen Bündnis soll gebrochen werden?",

    "diplomacy.cold_shoulder": (pick: "salt", lines: [
        "Ich habe dir nichts mehr zu sagen. Lass mich allein.",
        "Nein. Wir haben genug geredet. Hinweg.",
        "Belästige mich nicht wieder, bevor du Manieren gelernt hast.",
    ]),

    "diplomacy.accepted_pact": (pick: "salt", lines: [
        "Nun gut. Ein Pakt zwischen uns soll gelten.",
        "Einverstanden. Unsere beiden Häuser sollen Frieden halten.",
    ]),
    "diplomacy.accepted_alliance": (pick: "salt", lines: [
        "Ein Bündnis also! Gemeinsam sind wir schwer aufzuhalten.",
        "Einverstanden. Deine Feinde sind meine, und meine sind deine.",
    ]),
    "diplomacy.accepted_peace": (pick: "salt", lines: [
        "Genug Blut ist geflossen. Also Frieden.",
        "Ich nehme an. Das Kämpfen ist vorbei, vorerst.",
    ]),
    "diplomacy.ai_proposes_pact": "{wizard} schlägt einen Magierpakt zwischen euch vor. Nimmst du an?",
    "diplomacy.ai_proposes_alliance": "{wizard} schlägt ein Bündnis zwischen euch vor. Nimmst du an?",
    "diplomacy.ai_proposes_peace": "{wizard} bietet Frieden an. Nimmst du an?",
    "diplomacy.ai_proposes_war": "{wizard} bittet dich, {third} den Krieg zu erklären. Nimmst du an?",
    "diplomacy.ai_proposes_break": "{wizard} bittet dich, dein Bündnis mit {third} zu brechen. Nimmst du an?",
    "diplomacy.ai_proposes_trade": "{wizard} bietet dir {give} für {get} an. Nimmst du an?",
    "diplomacy.ai_demands": "{wizard} verlangt {gold} Gold von dir. Zahlst du?",
    "diplomacy.accepted_war": "So sei es. Unsere Armeen werden gegen sie marschieren.",
    "diplomacy.accepted_break": "Du hast mich überzeugt. Dieses Bündnis ist beendet.",
    "diplomacy.accepted_trade": "Ein fairer Handel. Hier ist, was ich versprochen habe.",

    "diplomacy.refused_treaty_cold": (pick: "salt", lines: [
        "Ein Vertrag mit dir? Du bist wahnsinnig, das zu fragen.",
        "Niemals. Eher würde ich einer Viper trauen.",
    ]),
    "diplomacy.refused_treaty": (pick: "salt", lines: [
        "Ich bin für eine solche Bindung nicht bereit. Vielleicht ein andermal.",
        "Nein. Dafür kenne ich dich nicht gut genug.",
    ]),
    "diplomacy.refused_peace_cold": "Es gibt keinen Frieden, bevor du für dein Tun bezahlt hast.",
    "diplomacy.refused_peace": "Noch nicht. Ich bin mit dir noch nicht fertig.",
    "diplomacy.refused_war": "Dieser Krieg ist nicht meiner. Ich lehne ab.",
    "diplomacy.refused_break": "Ich halte meinen Verbündeten die Treue. Ich werde sie nicht brechen.",
    "diplomacy.refused_trade": "Dieser Handel gefällt mir nicht.",
    "diplomacy.refused_threat": "Du wagst es, mir zu drohen? Wir werden sehen, wer Grund hat, es zu bereuen.",
    "diplomacy.accepted_threat": "Nun gut. Ich werde das nicht vergessen, aber ich stehe dir vorerst nicht im Weg.",
    "diplomacy.threat_war": "Dann herrscht Krieg zwischen uns!",

    "diplomacy.lapsed": "Ich werde darüber nachdenken.",
    "diplomacy.gold_thanks": (pick: "salt", lines: [
        "Deine Großzügigkeit ist bemerkt und wird nicht vergessen.",
        "Gold ist stets willkommen. Du bist klüger, als ich dachte.",
    ]),
    "diplomacy.spell_thanks": (pick: "salt", lines: [
        "Ein Geschenk des Wissens! Ich stehe in deiner Schuld.",
        "Du teilst deine Geheimnisse freigebig. Ich werde daran denken.",
    ]),
    "diplomacy.treaty_broken": "So ist unsere Abmachung zu Ende. Erwarte nicht, dass ich das vergesse.",
    "diplomacy.nothing_to_trade": "Wir haben nichts zu tauschen: Du hast keinen Zauber, der mir fehlt, oder ich keinen, der dir fehlt.",

    "diplomacy.forget_it": "Vergiss es",
