// Player-facing messages of the setup program (`f4x-setup`, docs/installer-design.md). One key is in one file only (docs/text.md).
{
    "setup.title": "Fantasy 4X setup",
    "setup.welcome": "This sets up the pictures of Fantasy 4X from your own copy of Master of Magic.\n\nThe pictures are made on this computer and kept in:\n{folder}\n\nNothing is uploaded or shared. It takes a few minutes.",
    "setup.start": "Continue",
    "setup.cancel": "Cancel",
    "setup.choose_other": "Choose folder",
    "setup.choose": "Choose the folder with your copy of Master of Magic",
    "setup.ask_folder": "Folder with your copy of Master of Magic (you can drag it here): ",
    "setup.no_folder": "No folder was given.",
    "setup.try_again": "{problem}\n\nChoose another folder?",
    "setup.err_not_folder": "{path} is not a folder.",
    "setup.err_unreadable": "Cannot read {path}: {why}",
    "setup.err_no_game": "This does not look like the original Master of Magic: {path} has no {file}, and neither has a folder inside it. Choose the folder that holds the game's .LBX files.",
    "setup.err_several": "{path} holds the game's files more than once: {names}. Choose the one you want.",
    "setup.found": "Found the game's files in {path}",
    "setup.complete": "The copy is complete.",
    "setup.names_more": "{names} and {n} more",
    "setup.check_missing": (count: "n", one: "One of the game's files is missing from this folder: {names}.", other: "{n} of the game's files are missing from this folder: {names}."),
    "setup.check_damaged": (count: "n", one: "One file is not what it should be (cut short, or another kind of file): {names}.", other: "{n} files are not what they should be (cut short, or another kind of file): {names}."),
    "setup.incomplete": "Is this a complete copy of the original game? Nothing was extracted.",
    "setup.target": "The pictures go to {folder}",
    "setup.stage_read": "Reading the pictures of the original game. This takes a few minutes.",
    "setup.stage_pack": "Packing the pictures.",
    "setup.stage_place": "Putting the pictures in place.",
    "setup.done": "Done: {pictures} pictures in {packs} files in {folder}",
    "setup.err_link": "{folder} is a link to {target}. Setup will not write through it: remove the link, or choose another data folder.",
    "setup.err_failed": "Setup stopped: {why}",
    "setup.working": "Please wait. Do not close this window.",
    "setup.close": "Close",
    "setup.usage": "f4x-setup: extract the pictures of your own copy of Master of Magic for the game.\n\nusage: f4x-setup [--cli] [--game DIR] [--data DIR] [--check]\n  --cli        ask and answer in this terminal instead of in windows\n  --game DIR   the folder with your copy of the original (asked for when left out)\n  --data DIR   where the game keeps its pictures and saves (default: the folder of your user for the game; on a Mac ~/Library/Application Support/Fantasy4X)\n  --check      only check that the copy is complete; extract nothing\nNothing from the original is uploaded or copied anywhere but into the data folder.",
    "setup.err_option": "Unknown option {option}.",
    "setup.err_value": "{option} needs a folder.",
}
