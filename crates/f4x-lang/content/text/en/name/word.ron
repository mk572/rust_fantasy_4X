    "city_size.outpost": (text: "Outpost", an: true),
    "city_size.hamlet": "Hamlet",
    "city_size.village": "Village",
    "city_size.town": "Town",
    "city_size.city": "City",
    "city_size.capital": "Capital",

    "month.january": "January",
