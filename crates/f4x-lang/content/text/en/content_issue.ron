// Player-facing messages about problems with the game's files and saves (`crates/f4x-client/src/issue_screen.rs`,
// docs/content-policy.md). One sentence for each kind of issue; `d1`, `d2`, `d3` are the details the loader gives.
{
    "content_issue.title_start_refused": "The game cannot start",
    "content_issue.title_start_degraded": "The game starts without some of its content",
    "content_issue.title_load_refused": "This saved game cannot be loaded",
    "content_issue.title_load_notes": "About this saved game",
    "content_issue.title_other": "The game cannot start",
    "content_issue.intro_refused": "Something is wrong with the game's files. Put it right (or take the mod away) and start again.",
    "content_issue.intro_degraded": "The parts listed below are broken and are left out. The rest of the game is whole.",
    "content_issue.intro_load_refused": "The game was not loaded.",
    "content_issue.intro_load_changed": "The game was made with other content files than the ones loaded now. Loading it anyway can break it.",
    "content_issue.intro_load_notes": "The game loaded. Please note:",
    "content_issue.layer_mod": "mod",
    "content_issue.layer_shipped": "game files",
    "content_issue.layer_save": "saved game",
    "content_issue.where": "{layer}, {file}, {at}",
    "content_issue.where_file": "{layer}, {file}",
    "content_issue.missing": "Missing: {d1}",
    "content_issue.unreadable": "Cannot be read: {d1}",
    "content_issue.corrupt": "Not valid: {d1}",
    "content_issue.wrong_type": "Wrong kind of value: {d1}",
    "content_issue.out_of_range": "{d1} is {d2}; it must be {d3}",
    "content_issue.dangling": "{d1} names a {d2} that does not exist: {d3}",
    "content_issue.duplicate": "{d1} {d2} is used twice",
    "content_issue.unknown_key": "A key that nothing uses: {d1}",
    "content_issue.conflict": "{d1}",
    "content_issue.plain": "{d1}",
    "content_issue.quit": "Quit",
    "content_issue.continue": "Continue",
    "content_issue.back": "Back to the menu",
    "content_issue.cancel": "Cancel",
    "content_issue.load_anyway": "Load anyway",
}
