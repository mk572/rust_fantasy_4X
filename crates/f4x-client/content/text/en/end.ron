// Player-facing messages of the end of the game: the headline and the score sheet.
// One key is in one file only (docs/text.md).
{
    "end.victory": "Victory!",
    "end.defeat": "Defeat",
    "end.won_mastery": "You have finished the Spell of Mastery and rule all of Arcanus and Myrror.",
    "end.won_conquest": "Every rival wizard has been defeated.",
    "end.lost_mastery": "{winner} has finished the Spell of Mastery.",
    "end.mastery_cast": "{winner} has cast the",
    "end.lost_conquest": "You have lost your last city to {winner}.",
    "end.log": "{title} {reason}",
    "end.hall_save_failed": "The Hall of Fame could not be saved: {why}",
    // The victory speech, a line every fifteen steps of the scene.
    "end.win_1": "Having conquered both the",
    "end.win_2": "world of Arcanus and Myrror,",
    "end.win_3": "I and only I, remain the one",
    "end.win_4": "and true Master of Magic.",
    // The raiders destroying a wizard: the fortress when the wizard has other cities.
    "end.raiders_fortress": "Raiders destroy {loser}'s fortress.",
    "end.raiders": "Raiders destroy {loser}.",
    // A wizard destroying another (a scene of our own: the original shows none).
    "end.conquers_fortress": "{winner} destroys {loser}'s fortress.",
    "end.conquers": "{winner} destroys {loser}.",
    "end.returns": "{wizard} begins casting the Spell Of Return.",
    // The score sheet: how many, and the points they are worth.
    "end.spells": (count: "n", one: "{n} Spell: {points}", other: "{n} Spells: {points}"),
    "end.townsfolk": "{n} Townsfolk: {points}",
    "end.banished": (count: "n",
        zero: "No Banished Wizards: {points}",
        one: "1 Banished Wizard: {points}",
        other: "{n} Banished Wizards: {points}"),
    "end.fame": "{n} Fame: {points}",
    "end.year": "Year {year}: {points}",
    "end.mastery": "Spell Of Mastery: {points}",
    "end.final_score": "Final Score: {n}",
}
