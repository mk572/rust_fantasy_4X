// Player-facing messages of the wizard creation screens. One key is in one file only (docs/text.md).
{
    // On the name step of a custom wizard; Tab turns the gender.
    "create.gender_hint": (gender: "wizard",
        masculine: "Tab: he",
        feminine: "Tab: she",
        neuter: "Tab: they"),
    "create.default_name": "You",
    "create.back": "Back",
    "create.pick_race": "Select a race first.",
    "create.race_hint": "Point at a race to read about it. Click a race to pick it, then OK.",
    "create.race.barbarian": "Low-tech settlers of Arcanus. Their towns breed fast and their troops throw weapons, which suits steady expansion and plain warfare. Friendly with Nomads and Orcs.",
    "create.race.gnoll": "A low-tech warrior race of Arcanus with the strongest regular troops of the plane, but little room to grow later. Plan on early conquest and plunder. Easy to get along with.",
    "create.race.halfling": "Friendly farmers of Arcanus, the best at growing food. Lucky, numerous troops, and slingers that hit above their weight. Liked nearly everywhere: a strong start.",
    "create.race.high_elf": "The only magical race of Arcanus: a little extra spell power helps the first turns. Slow growth, costly and fragile troops, cold relations except with Halflings, High Men and Nomads.",
    "create.race.high_men": "A plain military race of Arcanus whose Paladins, at the end of the religious buildings, are very strong. A popular start and a popular target, and friendly with many races.",
    "create.race.klackon": "Industrial insects of Arcanus. Strong morale, income and production, but only when the fortress city is Klackon. Everything about them is built for their own settlements.",
    "create.race.lizardman": "Primitive warriors of Arcanus with little to build, but cheap, tough, amphibious troops and quick growth. A good choice for a small landmass. Tense with most races.",
    "create.race.nomad": "Merchants of Arcanus with mobile, ranged armies. A slow start: their gold from roads, rivers and the sea needs big cities. Well liked, second only to Halflings.",
    "create.race.orc": "A plain all-round race of Arcanus with no building limits and cheap units, though weaker than High Men. Troubles with Dwarves, Klackons and both kinds of elves.",
    "create.race.beastmen": "Versatile Myrrans who grow faster than the rest of their plane and field cheap, varied troops. They cover whatever the other Myrran races cannot do or build.",
    "create.race.dark_elf": "Powerful Myrran magicians: each citizen gives a full point of power and the troops cast ranged spells. They grow slowly, need many buildings and are hostile to nearly all.",
    "create.race.draconian": "Flying Myrrans with fiery breath, a good choice for small landmasses on Myrror. Their cities make much power and wealth. Unfriendly to everyone.",
    "create.race.dwarven": "The richest Myrrans: taxes, mines, production and roads make them the best economic race of the game. Heavy infantry, later cannons and golems. They dislike elves and non-humans.",
    "create.race.troll": "Warmongers of Myrror with huge combat strength and regeneration but poor growth. Made to build armies and win battles. Poor relations with the other Myrrans.",
    "create.select_picture": "Select Picture",
    "create.select_wizard": "Select Wizard",
    "create.custom": "Custom",
    "create.wizard_name": "Wizard's Name",
    "create.select_race": "Select Race",
    "create.arcanian": "Arcanian:",
    "create.myrran": "Myrran:",
    "create.need_myrran": "You can not select a Myrran race unless you have the Myrran special.",
    "create.select_banner": "Select Banner",
}
