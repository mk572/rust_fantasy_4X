// Kept by hand (the importer no longer writes this file).
(
    tax_unrest_percent: [0, 10, 20, 30, 45, 60, 75],
    racial_unrest: [[0, 1, 1, 1, 1, 1, 1, 1, 1, 2, 1, 0, 0, 1], [1, 0, 2, 2, 2, 0, 1, 2, 1, 2, 1, 1, 1, 2], [1, 2, 0, 2, 3, 2, 2, 4, 2, 2, 2, 2, 2, 3], [1, 2, 2, 0, 2, 1, 1, 1, 1, 2, 1, 1, 1, 2], [1, 2, 3, 2, 0, 1, 0, 3, 0, 2, 1, 0, 3, 4], [1, 0, 2, 1, 1, 0, 0, 1, 1, 2, 1, 1, 0, 0], [1, 1, 2, 1, 0, 0, 0, 0, 0, 2, 0, 0, 0, 0], [1, 2, 4, 1, 3, 1, 0, 0, 0, 2, 1, 0, 2, 3], [1, 1, 2, 1, 0, 1, 0, 0, 0, 2, 1, 0, 0, 1], [2, 2, 2, 2, 2, 2, 2, 2, 2, -2, 2, 2, 2, 2], [1, 1, 2, 1, 1, 1, 0, 1, 1, 2, 0, 1, 1, 1], [0, 1, 2, 1, 0, 1, 0, 0, 0, 2, 1, 0, 0, 1], [0, 1, 2, 1, 3, 0, 0, 2, 0, 2, 1, 0, 0, 0], [1, 2, 3, 2, 4, 0, 0, 3, 1, 2, 1, 1, 0, 0]],
    // The cost multiplier (percent) of a spell cast in battle: 5 at the fortress, else 10 plus 5 for
    // each of the distances in `beyond` the battle is further than; another plane counts as `far`.
    casting_range: (at_fortress: 5, base: 10, step: 5, beyond: [5, 10, 15, 20], far: 30),
    trade: (spell_book_pct: 5, spell_book_cap: 8, item_free_slot_pct: 150, item_taken_slot_pct: 100, item_no_user_pct: 50, unit_at_war_pct: 125, gold_per_rating: 10),
    // The combat forecast: the shares (percent) of the other side's worth below which a side is completely
    // outmatched, much weaker, slightly weaker; turned over they mark the other way.
    forecast: (bands_pct: (33, 60, 85)),
    diplomacy: (subversion_penalty: 25, max_rounds: 4, pact_relation: 10, alliance_relation: 50),
    offer: (first_turn: 30, ai_first_turn: 50, max_chance: 10, ai_bonus: 10),
    outpost: (start_tens: 3, city_tens: 10),
    threat: (raider_limit: 30, rampage_damage: 40, cheapest_monster: 25, big_events_from_turn: 150, spared_realms: [3 /* life */],
        // The raid from the sea (setting `sea_raids`): the ship by turn, the party's size and strength by turn.
        sea_raid: (chance_percent: 25, ships: [(0, 35 /* trireme */), (120, 36 /* galley */)], parties: [(0, 0, 2, 2), (121, 1, 2, 4), (251, 2, 3, 0)] /* (from turn, base, dice sides, pool of cheapest units; 0 = all): 1d2 of the 2 cheapest, 1d2+1 of the 4 cheapest, 1d3+2 of all */, coast_rolls: 4)),
    // (from this many figures, at least this many defenders)
    garrison_minimum: [(1, 1), (3, 2), (6, 3), (9, 4)],
    // The citizens from which a city is a hamlet, village, town, city and (the fifth) capital-sized; below the first it is an outpost.
    city_size_from: [1, 5, 9, 13, 17],
    // (population - 2 at or above, building): barracks, smithy, builders hall, armory, granary, stables,
    // city walls, fighters guild, armorers guild, shrine
    starting_buildings: [(0, 3), (1, 8), (2, 32), (3, 4), (5, 29), (6, 9), (8, 35), (10, 5), (11, 6), (12, 22)],
    // Halfling, High Elf, High Men, Klackon, Nomad
    limited_ai_races: [6, 7, 8, 9, 11],
    // The pairs of realms a computer wizard's books may be merged in, in the order they are tried, as the original's
    // Consolidate_Spell_Book_Realms (ReMoM INITGAME.c) has them: death with chaos, nature, sorcery; life with chaos,
    // nature, sorcery; sorcery with chaos, nature. Life and death, and chaos and nature, are not merged.
    mergeable_realms: [(4 /* death */, 2 /* chaos */), (4 /* death */, 0 /* nature */), (4 /* death */, 1 /* sorcery */), (3 /* life */, 2 /* chaos */), (3 /* life */, 0 /* nature */), (3 /* life */, 1 /* sorcery */), (1 /* sorcery */, 2 /* chaos */), (1 /* sorcery */, 0 /* nature */)],
    // iron ore, coal, silver ore, gold ore, gem, mithril ore, adamantium ore, quork crystal, crysx crystal
    event_ores: [11, 5, 19, 10, 9, 12, 2, 17, 6],
    // The capital starts with 4 citizens (3 farm) and a smithy, barracks and builders hall; a spell cast
    // overland costs 5 times its battle price; each book beyond the 7th takes 10 percent off a cost; Evil
    // Omens adds half; a hero's battle mana is (skill + 1) * (level + 1) * 2.5.
    wizard: (start_tax_rate: 2, capital_figures: 4, capital_farmers: 3, capital_buildings: [8, 3, 32], max_retorts: 6, research_slots: 8, resign_below_skill: 40, overland_cost_factor: 5, evil_omens_percent: 50, book_steps_from: 7, book_step_percent: 10, mastery_discount_books: 11, mastery_discount: 3000, hero_mana_percent: 250),
    // Items: the plain item's cost by kind, the mail's own defence, the limits of a design, the mana to move an item to a hero far away, and the random item.
    item: (
        base_cost: [(Sword, 100), (Mace, 100), (Axe, 100), (Bow, 100), (Staff, 300), (Wand, 200), (Misc, 50), (Shield, 100), (Chainmail, 100), (Platemail, 300)],
        kind_defense: [(Chainmail, 1), (Platemail, 2)],
        max_powers: 4, max_charges: 4, free_group: 9, enchant_max_power_cost: 200,
        transfer_mana: 20,
        random_value_base: 700, random_value_step: 100, random_value_steps: 10, random_max_power_cost: 20000,
        enchant_random_powers: 2, many_random_powers: 4, other_random_powers: 3,
        many_power_kinds: [Sword, Mace, Axe, Staff, Wand],
        search_tries: 50,
    ),
    // Abilities by number (abilities.ron): the mobility estimate (percent of the movement rate), the
    // carriers of a whole stack, the undead's immunities, the magic ranged attacks, the armsmasters and
    // the chaos mutations.
    abilities: (
        mobility: [(49 /* non_corporeal */, 300), (74 /* wind_walking */, 300), (24 /* flying */, 200), (50 /* pathfinding */, 200), (45 /* mountaineer */, 120), (25 /* forester */, 120), (71 /* water_walking */, 120)],
        flying_movement_pct: 200, swimming_movement_pct: 150,
        stack_carriers: [50, 74],
        undead_immunities: [16 /* death */, 10 /* cold */, 52 /* poison */, 31 /* illusion */],
        magic_ranged: [36 /* lightning bolt */, 22 /* fireball */, 60 /* sorcery bolt */, 14 /* death bolt */, 29 /* ice bolt */, 58 /* shaman bolt */, 47 /* nature bolt */],
        armsmaster: 81, super_armsmaster: 82,
        mutation: (mutated: 98, armor_marker: 104, wings_marker: 105, breath_marker: 106, wings_ability: 24, breath_ability: 20, thrown_ability: 69, thrown_most: 3, armor_defense: 3, wings_moves: 2, breath_strength: 2, breath_ammo: 1),
    ),
    // Experience and fame: per dead enemy unit and per turn, the dead that cost a point of fame, the cost of a very rare
    // foe, Just Cause and the fortress prize, the level Heroism gives (from 0) and the resistance Charmed adds.
    renown: (xp_per_kill: 2, xp_per_turn: 1, fame_kills: 4, rare_foe_cost: 600, just_cause_fame: 10, fortress_prize_fame: 5, heroism_level: 3, charmed_resistance: 30,
        // A winner's foe loses a point of fame for each this many levels (rounded up) of a fallen hero.
        hero_levels_per_fame: 2),
    // The overland spells: chances in a hundred, strengths, penalties, and the buildings and realms they single out.
    spell_effects: (
        collapse_percent: 15, mineral_percent: 20, cool_percent: 2, armageddon_city_percent: 25,
        corruption_fade_percent: 2, armageddon_unrest: 2, wasting_unrest: 1,
        chaos_rift_bolts: 5, chaos_rift_strength: 8, chaos_rift_building_percent: 5,
        meteor_strength: 4, meteor_building_percent: 1,
        void_building_percent: 50, void_unit_damage: 10, void_corrupt_percent: 50, void_citizen_percent: 50,
        wrath_unit_percent: 10, wrath_building_percent: 5,
        safe_distance: 2, min_squares: 3, square_spread: 4, scatter_tries: 50, sea_percent: 20,
        werewolves: 168 /* werewolves */,
        black_wind_modifier: -1, unsummoning_modifier: -2, drain_rolls: 10, drain_die: 20,
        earthquake_building_percent: 15, earthquake_unit_percent: 25,
        spell_lock_difficulty: 150, suppress_magic_strength: 500,
        // Wind Mastery: the movement of the ships and fliers of a wizard who keeps it, and of the others', in percent.
        wind_mastery_own_percent: 150, wind_mastery_other_percent: 50,
        // Charm of Life adds this percent of a figure's hits (at least 1); Crusade this many levels.
        charm_of_life_percent: 25, crusade_levels: 1,
        consecration_realms: [4 /* death */, 2 /* chaos */],
        religious_buildings: [22 /* shrine */, 23 /* temple */, 24 /* parthenon */, 25 /* cathedral */],
        city_walls: 35,
        nightshade_buildings: [22 /* shrine */, 10 /* animists_guild */, 23 /* temple */, 24 /* parthenon */, 25 /* cathedral */, 17 /* sages_guild */, 18 /* oracle */, 19 /* alchemists_guild */, 21 /* wizards_guild */],
        nightshade_strength: 100,
    ),
    // The retorts that cost two picks under the Adamant Alchemy and 2-Pick Myrran settings, and the
    // ships whose capacity the player sets.
    // The cavalry and halberdier units of the setting `cavalry_halberdier_abilities`, and the abilities
    // it gives them (first_strike, negate_first_strike).
    targets: (
        alchemy_retort: 0, myrran_retort: 9, trireme_unit: 35, galley_unit: 36,
        cavalry_units: [42 /* barbarian_cavalry */, 60 /* dark_elf_cavalry */, 98 /* high_elf_cavalry */, 107 /* high_men_cavalry */, 141 /* orc_cavalry */],
        halberdier_units: [48 /* beastmen */, 59 /* dark_elf */, 68 /* draconian */, 77 /* dwarven */, 85 /* gnoll */, 97 /* high_elf */, 116 /* klackon */, 122 /* lizardman */, 139 /* orc */, 149 /* troll */],
        first_strike: 23, negate_first_strike: 48,
    ),
    autobuild_order: [29, 32, 26, 16, 23, 3, 8, 15, 22, 30, 17, 31, 34, 27, 35, 20, 4, 19, 9, 18, 24, 25, 28, 33, 14, 5, 21],
)
