// How the AI weighs a place for a city, in points (`f4x-ai` `city_site.rs`; `SiteRules` in
// `f4x-def/src/rules/ai_site.rs`). These are the AI's tuning, not rules of the game. Leave the file
// out to use these values.
(
    // What a square of each terrain is worth to the city that works it (food and growth).
    land_values: [
        (Grassland, 3.0), (SorceryNode, 3.0),
        (Forest, 2.0), (NatureNode, 2.0), (Hills, 2.0),
        (Swamp, 1.0), (Mountains, 1.0), (ChaosNode, 1.0),
        (Desert, 0.5), (Tundra, 0.5),
        (Ocean, 0.7),
    ],
    // A square that another city works too gives only this share of its value.
    shared_share: 0.4,
    // Per point of the production the land gives (percent over the area).
    production: 0.1,
    // Per point of mana, gold and food a special square gives.
    mana: 1.5,
    gold: 1.0,
    food: 1.0,
    // Per percent off the cost of soldiers (coal, iron).
    unit_cost: 0.2,
    // Per river square.
    river: 0.5,
    // The most a site gains from standing next to the wizard's own cities, and what each square
    // of distance takes off.
    near_own: 6.0,
    near_own_step: 0.8,
    // A rival's city within enemy_range squares lowers the site by the squares it is nearer times
    // enemy_peace, or enemy_war when the rival is at war with the wizard.
    enemy_range: 8,
    enemy_peace: 0.5,
    enemy_war: 1.5,
    // What a site over the sea costs against one on the home landmass.
    sea_cost: 10.0,
    // Sites that need a crossing count this many at most in the number of settlers wanted.
    crossing_sites_counted: 2,
)
