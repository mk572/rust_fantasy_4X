// The levers of the strategic AI (`f4x-ai`; `StrategyAiRules` in `f4x-def/src/rules/ai_strategy.rs`).
// These are the AI's tuning, not rules of the game. A run may override one with the environment
// variable `AIS_<NAME>`: the name in capitals (`AIS_ATTACK_FORCE=1.6`), with the group's prefix where
// the head of a group gives one (`AIS_DIPLO_B_OFFER=70`).
//
// Strengths are the AI's measure of what units are worth in battle; distances are in squares.
(
    // What several jobs read.
    shared: (
        // How near an own city, in squares, an enemy stack must be to threaten it, to be struck by a spell and to be worth a Stasis.
        near_city_radius: 3,
        // A defence that is seen or remembered in a city is worth this many times the strength of its units.
        city_defence_factor: 1.3,
        // Squares within which a city of a rival counts as near: for the garrison and the focus of a city, the roads to enchant and the razing of a captured city.
        rival_range: 12,
        // What a river square is worth, in points, to a place for a city and to the choice of a city's food buildings.
        river_worth: 0.5,
        // Mana the wizard keeps back from a craft, before it starts a global enchantment and before it sends an item to a hero away from the fortress.
        mana_reserve: 200,
    ),
    // When the armies, parties and monsters attack.
    attack: (
        // An AI player attacks (a lair, a tower, a city, a stack) when its force is this many times
        // as strong as the defence. The campaign gathers and the cities build towards the same.
        attack_force: 1.2,
        // The strength guessed for a defence the AI has not seen, in average soldiers of the wizard.
        guess: 3.0,
        // How long a remembered garrison is trusted, in turns.
        memory_turns: 80,
        // A force that has marched and not fought for this many turns (plus the walk) goes home to gather again.
        march_turns: 15,
        // Turns an enemy city that no march could reach is left alone.
        unreachable_turns: 40,
        // A city is threatened when the enemy near it is more than this share of the strength at home.
        threat_ratio: 0.8,
        // Monsters attack a city when this many times as strong as what they expect to meet.
        monster_edge: 1.0,
        // The share of a city's garrison an enemy stack must match to be worth a spell that strikes it.
        strike_share: 0.5,
        // The fewest units a march starts with.
        min_march: 3,
        // The fewest troops that cross a plane together.
        min_crossing: 3,
        // Squares beyond a city's own where a tower or a node still counts as in the city's zone.
        perimeter_site_range: 4,
        // Soldiers further than this from an enemy in a city's zone are not called.
        perimeter_reach: 6,
        // Strength a campaign wants beyond attack_force times what it expects to meet.
        march_margin: 1.0,
        // The strength of an average soldier of a wizard that has no fighter.
        no_fighter_strength: 20.0,
    ),
    // Which town a campaign marches on (the war plan, and the choice of a landing or a crossing).
    target: (
        // A town lies on the way when the walk through it is at most this much longer than the direct one.
        route_slack: 2,
        // What a town on the way is worth, in squares of walking.
        route_bonus: 6.0,
        // Squares of walking an average unit of a town's defence counts as.
        defence_squares: 1.5,
        // Squares of walking a rival's fortress city is worth to a landing or a crossing.
        fortress_bonus: 12.0,
        // What the fortress adds to a town's worth in the war plan.
        fortress_worth: 12.0,
        // The worth of a citizen of a town.
        size_worth: 1.0,
        // The worth of a building of a town.
        building_worth: 0.5,
        // A town of a wizard at war is worth this much more.
        war_worth: 3.0,
        // A town that is no wizard's is worth this share of the same.
        neutral_share: 0.6,
        // The worth the goal of the war loses per square from the nearest own city.
        goal_distance: 0.2,
        // The worth the goal loses when the army cannot walk to the town.
        goal_across: 15.0,
        // The rating the next target loses per square from the nearest own city.
        next_distance: 1.0,
        // What the next target gains for being the foothold towards a goal across.
        next_foothold: 5.0,
        // The share of a town's worth that counts for the next target.
        next_worth: 0.3,
        // A new goal must beat the one in hand by this much to replace it.
        goal_hold: 3.0,
        // The same for the next target.
        next_hold: 2.0,
        // The ground round a town counts as not yet seen when a square this near is unexplored.
        recon_radius: 4,
        // The most towns the plan asks the scouts to look at.
        recon_towns: 6,
        // Added to the value of a scouting square near such a town (a square of new ground is worth one).
        recon_bonus: 20.0,
        // How near a scouting square must be to the town to get it.
        recon_near: 3,
        // The most fighters the war plan asks the cities to build for one campaign.
        max_force: 20,
        // The walk, in squares, counted for the next target when the way to a town is not known.
        unknown_walk: 40,
    ),
    // How many soldiers stand in a city.
    garrison: (
        // Fighters the fortress city keeps with no enemy at war near it.
        garrison_fortress: 2,
        // Fighters any other city keeps then.
        garrison_city: 1,
        // Fighters the fortress keeps with a city of an enemy at war within rival_range.
        garrison_front_fortress: 6,
        // The same for any other city.
        garrison_front_city: 4,
        // Fighters the fortress keeps at war with no enemy city near.
        garrison_war_fortress: 3,
        // The share of that defence a wizard keeps while it builds up, in a city with no enemy near.
        build_garrison: 0.6,
        // Fighters a city keeps in the late game beyond what it wants.
        late_spare: 1,
        // Moves from which a unit is fast: it serves the scouting and the war better than a city's defence.
        fast_moves: 2,
    ),
    // Scouting.
    scouting: (
        // Scouts more than the AI would keep by itself, for a soak.
        scouts: 0,
        // How many squares of walking a square of new ground is worth.
        walk_cost: 0.35,
        // Turns a scout may stand still on an order before its target is given up.
        stuck_turns: 3,
        // Scouting targets this near another scout's are left to it.
        keep_apart: 5,
        // Fighters a sea scout carries to put ashore.
        sea_party: 2,
        // A plane explored less than this share is still blind to the wizard.
        blind_share: 0.6,
        // Up to this many cities a wizard keeps few_scouts, with more many_scouts.
        few_cities: 3,
        // The scouts of a wizard with up to few_cities cities,
        few_scouts: 1,
        // this many more while it builds up,
        builder_scouts: 1,
        // and the scouts of a wizard with more cities.
        many_scouts: 2,
        // How heavily walk_cost counts when a scout picks its target.
        walk_weight: 4.0,
        // Moves a flying unit counts for beyond its own when the scout is picked.
        flier_moves: 1,
        // The sight, in half squares, round a tower on the other plane in which unexplored ground makes a crossing worth it.
        across_sight_halves: 3,
    ),
    // Lairs, nodes and towers: the parties that take them.
    sites: (
        // Squares from a site within which soldiers are looked for to take it (lair, node or tower).
        range: 30,
        // What a party that cannot hurt weapon-immune guards is worth against them, as a share of what it would be worth otherwise (above 0).
        immune_discount: 0.2,
        // How much stronger than the party that lost on a site a party must be to try it again.
        retry_edge: 1.5,
        // The fewest spare soldiers that make a raiding party.
        site_party: 3,
        // Turns a muster waits for its soldiers before it sets off with those that came.
        muster_turns: 20,
    ),
    // What a place for a city is worth, in points. Overrides: AIS_CITY_SITE_<NAME>.
    city_site: (
        // What a square of each terrain is worth to the city that works it (food and growth). No
        // override reaches this list.
        land_values: [
            (Grassland, 3.0), (SorceryNode, 3.0),
            (Forest, 2.0), (NatureNode, 2.0), (Hills, 2.0),
            (Swamp, 1.0), (Mountains, 1.0), (ChaosNode, 1.0),
            (Desert, 0.5), (Tundra, 0.5),
            (Ocean, 0.7),
        ],
        // A square that another city works too gives only this share of its value.
        shared_share: 0.4,
        // Per point of the production the land gives (percent over the area).
        production: 0.1,
        // Per point of mana a special square gives.
        mana: 1.5,
        // Per point of gold a special square gives.
        gold: 1.0,
        // Per point of food a special square gives.
        food: 1.0,
        // Per percent off the cost of soldiers (coal, iron).
        unit_cost: 0.2,
        // The most a site gains from standing next to the wizard's own cities.
        near_own: 6.0,
        // What each square of distance takes off that.
        near_own_step: 0.8,
        // A rival's city within this many squares lowers the site (at least 1).
        enemy_range: 8,
        // By this much for each square it is nearer than the range.
        enemy_peace: 0.5,
        // The same when the rival is at war with the wizard.
        enemy_war: 1.5,
        // What a site over the sea costs against one on the home landmass.
        sea_cost: 10.0,
        // Sites that need a crossing count this many at most in the number of settlers wanted.
        crossing_sites_counted: 2,
        // The list of sites is made again after this many turns,
        refresh_turns: 5,
        // and when the wizard has explored this many squares more than at the last time.
        refresh_squares: 3,
        // The most squares of sea a search goes through.
        sea_limit: 3000,
        // The most squares of one landmass a search goes through.
        land_limit: 1500,
    ),
    // Taxes, gold, settlers and ships.
    economy: (
        // The highest tax rate the AI sets.
        max_tax_rate: 3,
        // The gold a turn the AI wants left over: it sets the lowest tax rate that gives it.
        net: 3,
        // The ships a wizard keeps by the sea before a landing asks for more.
        ships: 1,
        // The most ships a landing builds.
        max_ships: 4,
        // With this many idle fighters the wizard builds no more soldiers.
        idle_surplus: 4,
        // With this much gold the cities build units to spend it on.
        rich_gold: 1500,
        // Below this width (0 to 1) the wizard builds up its cities,
        tall_below: 0.35,
        // and above this one it spreads out.
        wide_above: 0.65,
        // The gold kept back when buying production or from another wizard: this,
        gold_reserve_base: 40,
        // plus this many turns of net income.
        gold_reserve_income: 3,
        // With a landing planned, one more ship for each this many fighters (above 0).
        fighters_per_ship: 12,
        // Settlers kept on the way past the number of cities wanted, leaning wide,
        settlers_wide: 3,
        // and leaning neither wide nor tall (none leaning tall).
        settlers_middle: 2,
        // The fewest citizens a city builds a settler from.
        settler_size: 3,
        // The gold on hand counts as income, spread over this many turns (above 0).
        gold_spread_turns: 100,
        // With net gold below 0 and less gold than this the treasury is broke.
        poor_gold: 60,
        // Before a campaign the strike army gains a fighter for each this many cities (above 0).
        cities_per_strike_fighter: 2,
        // Fighters a maniacal temper adds to the strike army,
        army_maniacal: 2,
        // a ruthless or aggressive one,
        army_fierce: 1,
        // and the fighters a peaceful one takes off it.
        army_peaceful: 1,
    ),
    // What the cities build.
    building: (
        // Net gold a turn below which a city builds toward gold first.
        gold_floor: 3,
        // Below this net gold the gold buildings are the first of the basics.
        rich_enough: 8,
        // Land that gives production is a specialty only from this many percent.
        land_production_min: 12.0,
        // River squares are a specialty in food from this many.
        rivers_min: 4,
        // Citizens from which a city is large, for a road enchantment.
        large_city: 8,
        // Percent a building adds to a stat that count as one point of it (above 0).
        percent_per_point: 10.0,
        // Percent of production from the land that count as one point of a city specialty (above 0).
        land_production_per_point: 3.0,
        // Percent off the cost of soldiers that count as one point of a city specialty (above 0).
        unit_cost_per_point: 5.0,
        // Points of a city specialty each nightshade square is worth.
        nightshade_worth: 2.0,
        // Soldiers a rival nearby adds to the least garrison a city builds,
        rival_guards: 1,
        // a first focus on defence,
        defense_guards: 2,
        // and a second focus on defence.
        defense_second_guards: 1,
    ),
    // The forge cities and the dismissal of cheap units late in the game.
    forge: (
        // The turn from which the forge cities are chosen.
        forge_turn: 150,
        // One forge city for this many cities, at least two (above 0).
        cities_per_forge: 5,
        // At most this many forge cities,
        most_forges: 4,
        // but with this much gold a conqueror's grow to half its cities,
        forge_rich_gold: 3000,
        // at most this many.
        most_forges_rich: 12,
        // A unit is low-tier when it costs this percent of its race's top land unit or less.
        low_tier_percent: 35,
        // The fewest forge cities.
        least_forges: 2,
        // A rich conqueror has one forge city for this many cities (above 0).
        rich_cities_per_forge: 2,
    ),
    // Casting overland: which spell, when, and the mana it takes.
    magic: (
        // How much a spell of a realm the wizard has all its books in gains.
        rate_affinity: 0.5,
        // The weight of a spell's upkeep against its casting cost.
        rate_upkeep: 12.0,
        // Mana that does the work of one average soldier in a fight (above 0).
        mana_per_soldier: 20.0,
        // The most soldiers the spells of one battle are counted for.
        most_soldiers: 6.0,
        // The mana wanted before a spell is begun, in percent of its cost.
        mana_wanted_percent: 150,
        // A spell that takes longer than this to pay for is not begun (above 0).
        most_paying_turns: 50,
        // A spell that costs more than this is only begun when it is paid within max_casting_turns.
        dear_spell: 300,
        // The most turns spent paying for one dear spell.
        max_casting_turns: 5,
        // A summon that this many turns of net mana income pay for is saved for.
        saving_turns: 15,
        // The army up to which the AI summons: this many fighters,
        army_cap_base: 12,
        // and this many more per city.
        army_cap_city: 2,
        // Unexplored squares a block must hold to be worth Earth Lore.
        explore_floor: 70,
        // Share of a stack's hit points (percent) that must be gone to be worth Nature's Cures.
        cure_percent: 35,
        // Squares from the summoning circle a stack must be to be worth a recall.
        recall_distance: 8,
        // Share of a stranded stack's hit points that must be gone to be worth a recall.
        recall_percent: 50,
        // How many times as strong as a unit a werewolf must be for Lycanthropy.
        lycanthropy_edge: 1.5,
        // The fewest fighters gathered that Plane Shift is cast for (an Astral Gate: beyond the
        // garrison of its city).
        min_shift: 6,
        // The most squares weighed to find the one the army gathers on for a Plane Shift.
        shift_squares: 12,
        // With a campaign on, the first Earth Gate goes up in the own city nearest the army's
        // rally point; further cities at least this far from it get one too.
        gate_far: 8,
        // The most cities with an Earth Gate.
        gates_max: 3,
        // Gold above this is turned into mana once the cities have bought what they can.
        gold_kept: 1000,
        // The race for the Spell of Mastery is run when the AI would finish this many times sooner than the rival.
        race_lead: 1.25,
        // The mana a fight can use: the pool, up to this many times the casting skill.
        usable_skill: 3.0,
        // The weight of a spell that takes walkers over the sea against a summon of the same step.
        cross_rate: 1000.0,
        // A global enchantment is dispelled when its cost is at most this many times the strength of the dispel.
        dispel_margin: 4,
        // The fewest fighters before a spell on a unit is cast.
        buff_army: 3,
        // With more than this percent of the power on mana, nothing that costs upkeep is cast.
        most_mana_share: 55,
        // What the wizard puts towards a spell each turn: its mana reserve spread over this many turns, and the mana income (above 0).
        reserve_turns: 10,
        // A wizard leans to a realm when this percent of its books or more are of it.
        lean_share_pct: 50,
    ),
    // How the power is split between mana, research and skill, in percent.
    split: (
        // The balanced split every wizard starts from: mana,
        base_mana: 30,
        // research,
        base_research: 40,
        // and skill. The goals, the phase and the state of the game move it.
        base_skill: 30,
        // The steps the shares move in (above 0).
        split_step: 5,
        // The least share of mana,
        least_mana: 0,
        // of research,
        least_research: 0,
        // and of skill.
        least_skill: 20,
        // Turns a mana reserve is meant to last when the income falls short of the upkeep.
        mana_horizon: 40,
        // A reserve this big is more than the wizard can spend soon.
        rich_reserve: 1500,
        // While the Spell of Mastery is cast: mana,
        mastery_mana: 50,
        // research,
        mastery_research: 0,
        // and skill.
        mastery_skill: 50,
        // With nothing left to research: mana,
        done_mana: 60,
        // research,
        done_research: 0,
        // and skill.
        done_skill: 40,
        // In a race to research the Spell of Mastery: mana,
        racing_mana: 15,
        // research,
        racing_research: 65,
        // and skill.
        racing_skill: 20,
        // While it builds up, mana moved to research.
        build_shift: 10,
        // While it wins, research moved to mana
        win_mana_shift: 15,
        // and to skill.
        win_skill_shift: 5,
        // With a rich reserve, mana moved to research.
        rich_shift: 10,
    ),
    // Items: crafting, buying and handing them out.
    items: (
        // The most an item the wizard crafts is worth, whatever the mana.
        craft_max_value: 800,
        // Powers on one crafted item.
        craft_powers: 3,
        // The percent of its value an item counts for a hero it suits,
        use_suits_percent: 150,
        // and for a hero it does not suit.
        use_misfit_percent: 50,
        // An item that replaces one a hero carries must be worth this percent of it.
        better_percent: 130,
        // The unusable items the vault may hold before the cheapest is scrapped.
        keep_unusable: 2,
        // What an item must be worth to be bought, in percent of its price without the markup.
        worth_percent: 100,
    ),
    // The mana spent in a battle.
    battle_spend: (
        // Turns of an upkeep shortfall the reserve keeps for itself.
        hold_turns: 10,
        // The share of the spare mana from which the limit falls away.
        no_limit: 0.75,
        // Attackers this many times the defence are certain winners: the least need.
        sure_ratio: 3.0,
        // Attackers this many times the defence or fewer need every spell they have.
        even_ratio: 1.2,
        // The least need there is.
        least_need: 0.2,
        // Squares from an own city within which a fight is on home ground.
        home_range: 3,
        // What a fight is worth, 0 to 1: for a city,
        stake_city: 1.0,
        // for a lair,
        stake_lair: 0.6,
        // on home ground,
        stake_home: 0.7,
        // in the open,
        stake_open: 0.3,
        // and at least this with a hero in it.
        stake_hero: 0.6,
    ),
    // Engineers, roads and bridges.
    engineers: (
        // The nearest cities an engineer links a city to.
        linked_cities: 3,
        // The cities of a link are at most this many squares apart.
        link_range: 12,
        // Cities for each engineer wanted while there is road to build (above 0).
        cities_per_engineer: 3,
        // Squares of a road toward the campaign target built at a time.
        road_stretch: 8,
        // Within this many squares of a rival's city an engineer works with an escort.
        engineer_escort_range: 8,
        // Turns a bridge of ships stays without anyone asking for it.
        bridge_keep_turns: 40,
    ),
    // Ships and boarding.
    transport: (
        // Fighters that must stand in the port before a ship sails.
        min_load: 3,
        // Boarding squares that get a path search, per group.
        candidates: 12,
        // How many turns longer than the best a unit may walk and still be taken aboard.
        straggler_turns: 5,
        // Two destinations on one landmass this near may share a ship.
        merge_range: 10,
        // How far from a unit a boarding square is looked for.
        shore_range: 12,
    ),
    // Wounded units, escorts and spirits.
    care: (
        // A unit below this share of its hit points rests.
        rest_percent: 60,
        // How far a wounded unit walks to a stack with a Healer.
        healer_range: 4,
        // How far a wounded unit walks to a city of its own.
        rest_city_range: 8,
        // An enemy unit this near is a danger to a charge walking alone.
        escort_enemy_near: 3,
        // An enemy unit this near is a danger to a wounded unit looking for a place to rest.
        rest_enemy_near: 3,
        // A hero this much of the average fighter's strength needs a guard in the field.
        weak_hero: 0.5,
        // Turns a spirit may stand still on its way before the node is given up.
        meld_patience: 4,
    ),
    // The phases of a game and how long a plan stands.
    planning: (
        // Before this turn a wizard with fewer cities than it wants is still building up.
        early_turn: 200,
        // From this turn a game is in its late phase.
        late_turn: 300,
        // Turns a plan may stand before it is dropped.
        plan_timeout_turns: 100,
        // Turns a scout may walk to one target before it is given up.
        scout_timeout_turns: 50,
        // A dropped target stays on the list of failures for this many times plan_timeout_turns.
        forgive_plans: 3,
        // With this many times the cities it wants, a wizard is in the winning phase.
        win_cities_times: 2,
    ),
    // What the two groups below share: power, the leader, factors and self-interest (statecraft.rs). Overrides: AIS_DIPLO_<NAME>.
    diplomacy: (
        // Whether the factors and the self-interest count in the willingness.
        on_factors: true,
        // Whether the AI refuses what arms an enemy.
        on_arms: true,
        // Whether the AI trades.
        on_trade: true,
        // A city's worth in army points.
        city_power: 100,
        // A neighbour that the AI's army is this percent of,
        dominant_army: 160,
        // and its cities this percent,
        dominant_cities: 150,
        // and that has this many cities of its own, is one the AI means to attack.
        dominant_min_cities: 3,
        // The leader holds this percent of the next best's power.
        leader_margin: 130,
        // Two wizards that fear the same leader get on better by this.
        coalition_bonus: 30,
        // Fame for each point of willingness (above 0),
        fame_per_point: 25,
        // at most this many points.
        fame_cap: 8,
        // Added for a Charismatic wizard.
        charismatic: 6,
        // Added for the same race.
        same_race: 8,
        // Added for each realm both have books in,
        shared_realm: 3,
        // at most this.
        shared_cap: 6,
        // Taken off for Life against Death.
        opposed_realm: 4,
        // Taken off for a broken treaty.
        broken_memory: 15,
        // Taken off toward a neighbour it means to attack,
        interest_target: 25,
        // and toward the leader.
        interest_leader: 15,
        // At this feeling or below a wizard will not talk to another it is not at war with.
        audience_refused_below: -90,
        // The gold of a gift.
        gift_gold: 50,
        // The treasury needed for a gift to another wizard,
        gift_least_gold: 100,
        // and for one to a close friend with a treaty.
        friend_gift_least_gold: 200,
        // The books both wizards need in a realm for it to count as shared or opposed.
        shared_books: 2,
    ),
    // Trades. Overrides: AIS_DIPLO_TRADE_<NAME>.
    trade: (
        // What a trade must bring, in percent of what it costs, between strangers,
        margin_none: 98,
        // with a pact,
        margin_pact: 95,
        // and with an ally.
        margin_alliance: 90,
        // Percent of margin less for every ten points of relation above zero (more below),
        margin_per_relation: 1,
        // and for every ten points of goodwill.
        margin_per_goodwill: 1,
        // The least the margin can be,
        margin_least: 85,
        // and the most.
        margin_most: 140,
        // The least gold it sells a spell or an item for.
        least_price: 40,
        // Fighters a city keeps beyond its garrison before one may be given away.
        unit_spare: 1,
    ),
    // Feelings, peace, friends and enemies (diplo_b*.rs, docs/ai-diplomacy-b.md). Overrides: AIS_DIPLO_B_<NAME>.
    diplomacy_b: (
        // The peace wish at which it offers a peace,
        offer: 80,
        // and the one at which it accepts one.
        accept: 60,
        // Turns between two offers to the same wizard.
        cool: 15,
        // Weariness up for a battle lost,
        battle_lost: 5,
        // down for one won,
        battle_won: 4,
        // up for a city lost,
        city_lost: 25,
        // down for one taken.
        city_taken: 25,
        // Weariness gained for every ten turns without a clash.
        drift_per_ten: 7,
        // The most the strength gap moves the wish, either way.
        gap: 50,
        // Percent of the fear that moves the wish; the stronger side hears half.
        fear_pct: 40,
        // Percent of the friendship that counts.
        friend_pct: 10,
        // A neighbour this percent weaker,
        prey_pct: 150,
        // and nearer than this, is prey,
        prey_distance: 30,
        // which lowers the wish by this.
        prey: 30,
        // The more dangerous of two fronts is worth this much more.
        two_fronts: 25,
        // A war younger than this is not ended,
        young_age: 10,
        // and by how much.
        young: 40,
        // The personality's mood divided by this is added (above 0).
        mood_div: 3,
        // Nearness is 100 minus this for each square between the nearest cities.
        near_per_square: 5,
        // What a city razed adds to a wizard's ruthlessness,
        ruth_raze: 15,
        // a war declared,
        ruth_war: 6,
        // a treaty broken,
        ruth_broken: 10,
        // a fortress taken,
        ruth_fortress: 10,
        // and a wizard destroyed.
        ruth_destroyed: 20,
        // Turns in which it fades by half.
        ruth_half: 150,
        // The most of it that counts, in fear points.
        ruth_cap: 60,
        // Taken off the peace wish toward the caster of the Spell of Mastery.
        mastery: 60,
        // With a leader in the game: added toward the others, taken off toward the leader.
        leader: 15,
        // Turns between two looks at the others.
        review: 5,
        // Turns an enemy is kept at least,
        hold: 40,
        // and the value below which it is then let go.
        keep: 20,
        // The enemy value a wizard needs to be chosen,
        enemy_min: 25,
        // and to be declared war on.
        declare: 30,
        // At war, another war is declared only with this many times that enemy's army.
        busy_army_x: 2,
        // What each war already fought takes off the willingness to declare another.
        war_damp: 15,
        // The most a weak neighbour in reach is worth as prey.
        prey_value: 60,
        // Added to the enemy value of one already fought,
        at_war: 30,
        // of the leader,
        leader_enemy: 25,
        // and of the caster of the Spell of Mastery.
        mastery_enemy: 60,
        // Percent of the hostility (negative friendship) that counts.
        hostile_pct: 30,
        // The fear at which an equal or weaker wizard strikes first.
        strike_fear: 50,
        // No war before this turn,
        from_turn: 5,
        // and none on a wizard this much stronger (percent).
        too_strong_pct: 130,
        // Percent of the friendship in the friend value.
        stance_friend_pct: 30,
        // What a shared enemy adds to it.
        common_enemy: 30,
        // Percent of the fear of a stronger neighbour that it adds.
        grovel_pct: 40,
        // What the league against the leader adds.
        league: 20,
        // The friend value at which it asks for a pact,
        pact_min: 30,
        // for an alliance,
        ally_min: 55,
        // and gives a gift.
        gift_min: 25,
        // Turns between two advances to the same wizard.
        court_cool: 20,
        // The friend value at which a pact is accepted,
        pact_accept: 20,
        // an alliance,
        ally_accept: 45,
        // and a war on a third wizard.
        war_accept: 60,
        // The lead in friendship over a third at which it breaks an alliance for the asker.
        break_accept: 40,
        // The friendship at which it warns a treaty partner,
        warn_below: -30,
        // breaks the treaty,
        break_below: -50,
        // and declares war on one it has no treaty with.
        war_below: -75,
        // Turns between two warnings to the same player,
        warn_cool: 10,
        // two demands,
        demand_cool: 20,
        // two gifts,
        gift_cool: 30,
        // and two trade offers.
        trade_cool: 15,
        // The friendship from which a treaty partner is given gifts.
        gift_friend: 60,
        // The fear from which a wizard yields to a threat or a demand.
        yield_fear: 50,
        // What an ally at war with a wizard adds to its enemy value.
        ally_war: 30,
        // What a pact adds to the feeling each turn, in hundredths of a point, before the diminishing returns,
        pact_growth: 100,
        // and an alliance.
        alliance_growth: 175,
        // At the last warning of a trespass: the friendship at which it breaks the treaty,
        trespass_break_below: 0,
        // and at which it declares war.
        trespass_war_below: -50,
        // How many points short of accepting a treaty it still names a price,
        counter_reach: 30,
        // and the gold it asks, or pays, for each point.
        gold_per_point: 5,
        // Turns between two calls to the same ally to join a war,
        call_cool: 30,
        // against an enemy of at least this percent of the caller's power.
        call_enemy_pct: 80,
        // What an ally's price for joining takes off the caller's feeling for it, before the diminishing returns.
        call_price_penalty: 3,
        // It will not swap world maps once it has explored this percent of the other's squares,
        map_refuse_pct: 300,
        // offers a swap that would show it at least this many new squares,
        map_least_news: 40,
        // and no more often to the same player than this many turns.
        map_cool: 30,
        // A trade or research pact is offered no more often to the same player than this.
        pact_cool: 30,
        // A neighbour with this percent of our power or less is no might to fear.
        might_floor: 50,
        // The stronger side hears its fear in the peace wish divided by this (above 0).
        strong_fear_divisor: 2,
        // A wizard with at most this percent of our power is one we strike first when we fear it.
        equal_pct: 110,
        // The fear divided by this is then added to the enemy value (above 0).
        strike_fear_divisor: 2,
        // Taken off the enemy value of a pact partner,
        pact_penalty: 40,
        // and of an ally.
        alliance_penalty: 80,
        // Tributes and demands are made in steps of this much gold (above 0).
        gold_step: 25,
        // A wizard that yields to a threat pays this many steps,
        tribute_least_steps: 2,
        // and one more for each this much fear (above 0).
        tribute_fear_per_step: 25,
        // A threat is answered with war when the threatener's army is under this percent of ours.
        far_stronger_pct: 80,
        // A demand is made of a wizard with at least this much gold,
        demand_least_gold: 100,
        // for its gold divided by this (above 0),
        demand_share_divisor: 4,
        // at most this much.
        demand_most: 100,
        // On every turn that is a multiple of this a gift is a spell, when there is one to give (above 0).
        spell_gift_every: 3,
    ),
    // Whether a captured city is razed, in points that speak for razing (raze.rs). Overrides: AIS_RAZE_<NAME>.
    raze: (
        // A maniacal wizard,
        maniacal: 30,
        // a ruthless one,
        ruthless: 15,
        // a chaotic one,
        chaotic: 10,
        // an aggressive one.
        aggressive: 5,
        // Per step of unrest between the wizard's people and the city's.
        race_step: 10,
        // The land worth that speaks neither way,
        land_fair: 30,
        // the percent of the difference that counts,
        land_pct: 100,
        // and the most the land can say.
        land_cap: 25,
        // What each citizen takes off,
        citizen: 2,
        // the production cost of buildings that takes off one point (above 0),
        built_per_point: 50,
        // and the most a city's size can say.
        size_cap: 40,
        // No other own city near.
        alone: 20,
        // Per enemy city near beyond the own ones,
        exposed: 8,
        // and the most that says.
        exposed_cap: 24,
        // What city walls take off.
        walls: 10,
        // No soldier to hold the city.
        unheld: 25,
        // The city is razed above this.
        threshold: 50,
        // How near a soldier must stand to count as there to hold the city.
        reach: 3,
    ),
    // What each objective of a wizard changes (`objective.rs`; the pragmatist's is also that of a
    // wizard without one). Overrides: AIS_<OBJECTIVE>_<NAME> (AIS_MILITARIST_STRIKE_BASE), and
    // AIS_CITIES and AIS_STRIKE set cities_wanted and strike_base of all of them.
    objectives: (
        pragmatist: (
            // The most cities settled before the AI only builds up.
            cities_wanted: 7,
            // Fighters beyond the home guard, before a half per city more.
            strike_base: 4,
            // Rows skipped in the choice of the power split: more mana, less research.
            split_shift: 0,
            // What the research cost of a liked spell is multiplied by.
            like_share: 1.0,
            // Every n-th city of a settled wizard follows the other focus; 0 for none.
            variety_every: 0,
            // How far summons move up the order of casting (four is one step).
            boost_summon: 0,
            // The same for spells on units,
            boost_unit_buff: 0,
            // on cities,
            boost_city_buff: 0,
            // global enchantments,
            boost_global_buff: 0,
            // and curses.
            boost_curse: 0,
        ),
        militarist: (
            cities_wanted: 6,
            strike_base: 6,
            split_shift: 1,
            like_share: 0.67,
            variety_every: 3,
            boost_summon: 8,
            boost_unit_buff: 8,
            boost_city_buff: 0,
            boost_global_buff: 0,
            boost_curse: 12,
        ),
        theurgist: (
            cities_wanted: 6,
            strike_base: 3,
            split_shift: 0,
            like_share: 0.67,
            variety_every: 3,
            boost_summon: 0,
            boost_unit_buff: 0,
            boost_city_buff: 4,
            boost_global_buff: 12,
            boost_curse: 0,
        ),
        perfectionist: (
            cities_wanted: 5,
            strike_base: 3,
            split_shift: 0,
            like_share: 0.67,
            variety_every: 3,
            boost_summon: 0,
            boost_unit_buff: 0,
            boost_city_buff: 12,
            boost_global_buff: 12,
            boost_curse: 0,
        ),
        expansionist: (
            cities_wanted: 10,
            strike_base: 4,
            split_shift: 0,
            like_share: 0.67,
            variety_every: 3,
            boost_summon: 4,
            boost_unit_buff: 0,
            boost_city_buff: 4,
            boost_global_buff: 0,
            boost_curse: 0,
        ),
    ),
    // The wide or tall lean (phase.rs). Overrides: AIS_WIDTH_<NAME>; none reaches the lists.
    width: (
        // Races whose strength is in the field.
        wide_races: [12 /* orc */, 0 /* barbarian */, 13 /* troll */, 5 /* gnoll */, 1 /* beastmen */, 3 /* draconian */],
        // Races whose strength is in building and magic.
        tall_races: [7 /* high_elf */, 2 /* dark_elf */, 6 /* halfling */, 4 /* dwarven */, 11 /* nomad */],
        // Retorts that favour spreading out (heroes, armies, summons).
        wide_retorts: [1 /* warlord */, 13 /* famous */, 16 /* charismatic */, 15 /* conjurer */],
        // Retorts that favour building up (research, mana, gold, items).
        tall_retorts: [7 /* sage_master */, 0 /* alchemy */, 8 /* channeler */, 11 /* mana_focusing */, 10 /* archmage */, 12 /* node_mastery */, 14 /* runemaster */, 17 /* artificer */],
        // The realms of the fighter.
        wide_realms: [2 /* chaos */, 4 /* death */],
        // The realms of the builder.
        tall_realms: [0 /* nature */, 1 /* sorcery */, 3 /* life */],
        // The lean every wizard starts from.
        start: 0.5,
        // A race of wide_races adds this, one of tall_races takes it off.
        race: 0.1,
        // The same for each retort of wide_retorts and tall_retorts.
        retort: 0.08,
        // Added for a maniacal or ruthless temper,
        temper_fierce: 0.12,
        // for an aggressive one,
        temper_aggressive: 0.08,
        // and taken off for a lawful one
        temper_lawful: 0.04,
        // and for a peaceful one.
        temper_peaceful: 0.1,
        // Added for a militarist or expansionist, taken off for a theurgist or perfectionist.
        objective: 0.1,
        // Added for each book of wide_realms,
        wide_book: 0.03,
        // and taken off for each book of tall_realms.
        tall_book: 0.02,
        // Added while the wizard builds up,
        phase_build: 0.2,
        // and while it is winning,
        phase_win: 0.1,
        // taken off while it casts the Spell of Mastery.
        phase_mastery: 0.2,
        // Added with room for another city, taken off without.
        room: 0.2,
        // An enemy with this many times the cities (or the wizard against its strongest enemy)
        neighbour_ratio: 1.5,
        // takes this off the lean (adds it).
        neighbour: 0.1,
    ),
    // The choice of research: what the turns a spell takes are multiplied by. Overrides: AIS_RESEARCH_<NAME>.
    research: (
        // Of a sort the wizard has none of yet: a summon or a spell that harms in battle,
        new_fighting: 0.25,
        // and a spell on a unit or a city.
        new_buff: 0.7,
        // Of a sort it has: a spell on a unit or a city,
        owned_buff: 1.5,
        // and any other (a summon or a spell that harms in battle counts as it is).
        owned_other: 1.5,
        // The Spell of Mastery is researched last while it takes more turns than this, unless a rival races for it.
        mastery_turns: 250.0,
        // Enchant Road not yet known, when the wizard can have engineers,
        road_new: 0.5,
        // and when it cannot.
        road_never: 2.0,
    ),
    // The order in which kinds of spells are tried, the lower first; the Spell of Mastery always comes before all. Overrides: AIS_LADDER_<NAME>.
    ladder: (
        // Seeing the world,
        explore: 1,
        // Spell Blast,
        blast: 1,
        // enchanted roads (fast movement is a big advantage),
        enchant_road: 2,
        // healing a stack,
        cure: 2,
        // lifting a curse from an own city,
        disenchant: 2,
        // Stasis,
        stasis: 2,
        // Word of Recall,
        recall: 2,
        // Plane Shift,
        plane_shift: 2,
        // an Astral Gate,
        gate: 2,
        // a storm on an enemy stack,
        stack_strike: 2,
        // summoning creatures,
        summon: 3,
        // summoning heroes,
        summon_hero: 3,
        // taking walkers over the sea (they wait on the shore for it),
        cross: 3,
        // Lycanthropy (rated against the summons),
        lycanthropy: 3,
        // spells on units,
        unit_buff: 4,
        // Mutation,
        mutate: 4,
        // an Earth Gate (it saves the army its walk, it does not make it stronger),
        earth_gate: 4,
        // spells on own cities,
        city_buff: 5,
        // global enchantments,
        global_buff: 6,
        // raising a volcano,
        land_boost: 6,
        // curses on cities,
        city_curse: 7,
        // curses on land,
        land_curse: 7,
        // curses on wizards,
        wizard_curse: 8,
        // Disjunction,
        disjunction: 8,
        // and spells that strike the whole world.
        world_spell: 8,
    ),
    // What a wizard feels about the others, -100 to 100 (opinion.rs, docs/diplomacy.md section 5). Overrides: AIS_OPINION_<NAME>; none reaches the lists.
    opinion: (
        // What an overland enchantment does to the feeling for its caster (realms: 0 nature, 2 chaos, 3 life, 4 death). A spell not listed does nothing.
        enchantments: [
            (spell: 213 /* spell_of_mastery */, value: -50),
            (spell: 197 /* eternal_night */, value: -12),
            (spell: 198 /* evil_omens */, value: -20, with_books: [3, 0]),
            (spell: 188 /* zombie_mastery */, value: -14),
            (spell: 59 /* aura_of_majesty */, value: 10),
            (spell: 57 /* wind_mastery */, value: -4),
            (spell: 79 /* suppress_magic */, value: -4),
            (spell: 40 /* natures_wrath */, value: -20, with_books: [2, 4]),
            (spell: 116 /* chaos_surge */, value: -10, without_books: [2]),
            (spell: 117 /* doom_mastery */, value: -8),
            (spell: 114 /* great_wasting */, value: -20),
            (spell: 113 /* meteor_storm */, value: -15),
            (spell: 120 /* armageddon */, value: -25),
            (spell: 157 /* tranquility */, value: -20, with_books: [2]),
            (spell: 156 /* life_force */, value: -20, with_books: [4]),
            (spell: 158 /* crusade */, value: -10),
            (spell: 154 /* holy_arms */, value: -5),
        ],
        // What a curse on a city does to its owner's feeling for the caster: the spell and the value.
        city_spells: [
            (26 /* earthquake */, -9),
            (85 /* corruption */, -25),
            (98 /* raise_volcano */, -50),
            (110 /* chaos_rift */, -5),
            (119 /* call_the_void */, -20),
            (183 /* evil_presence */, -5),
            (189 /* famine */, -5),
            (190 /* cursed_lands */, -5),
            (196 /* pestilence */, -8),
        ],
        // On the colour wheel, for each pair of books of one realm,
        wheel_kin: 2,
        // of neighbouring realms,
        wheel_next: 1,
        // and taken off for opposed ones.
        wheel_opposed: 3,
        // The first feeling is no lower than this far below 0.
        start_floor: 90,
        // With Life books against Death books, taken off for each of these books.
        life_death_clash: 5,
        // Otherwise added for each Life book of the two,
        life_book: 2,
        // and taken off for each Death book of the wizard with more.
        death_book: 3,
        // Taken off for each Chaos book of the wizard with more.
        chaos_book: 2,
        // Added for each book both have of Sorcery, Chaos, Nature or Life.
        shared_book: 2,
        // At war a feeling is at least this far below 0.
        war_hostility: 25,
        // Without an alliance a feeling is no higher than this.
        no_alliance_most: 65,
        // A good deed to one disliked, and a bad one by one liked, counts this many times.
        contrast_factor: 2,
        // A good deed to one disliked lifts the feeling to no more than this.
        good_low_ceiling: 10,
        // A good deed to one liked, and a bad one by one disliked, is divided by one more for each this many points of the feeling (above 0).
        diminish_step: 25,
        // Percent a lawful wizard counts a bad deed at,
        lawful_bad_pct: 200,
        // a maniacal one a bad deed,
        maniacal_bad_pct: 150,
        // and a maniacal one a good deed.
        maniacal_good_pct: 75,
        // Taken off for a city captured from the wizard.
        city_taken: 40,
        // Taken off at the first warning of a trespass,
        trespass_first: 2,
        // and at the last one.
        trespass_last: 5,
        // Taken off the lasting regard of the victim for a broken pact,
        broken_pact: 10,
        // and for a broken alliance (also off where the feeling drifts back to).
        broken_alliance: 20,
        // This many times as much when the breaker is lawful.
        lawful_breaker_times: 2,
        // Taken off the feeling of the victim.
        broken_victim: 10,
        // Taken off the lasting regard of every other wizard.
        broken_bystander: 5,
        // Gold given counts by its share of what the receiver held, in this many steps at most;
        gift_steps: 4,
        // each step is this much,
        gift_per_step: 4,
        // a flat this much for a receiver with no army,
        gift_no_army: 8,
        // and the sum is divided by this (above 0).
        gift_divisor: 10,
        // A spell given counts this much from a wizard disliked;
        spell_low: 20,
        // from one liked, what is missing to 100 divided by this (above 0).
        spell_divisor: 10,
        // The feeling rises by this percent of that,
        spell_pct: 70,
        // the lasting regard by this,
        spell_regard: 5,
        // up to this.
        spell_regard_most: 30,
        // Taken off by the maker of a demand that is turned down,
        demand_refused: 6,
        // by one that is threatened,
        threatened: 7,
        // and added for a trade agreed.
        trade_agreed: 5,
        // Taken off for a hero lost in a battle.
        loss_hero: 20,
        // Taken off for each other unit lost, in half points,
        loss_unit_halves: 19,
        // and more for a settler, in half points.
        loss_settler_halves: 9,
        // Taken off for a failed assault on the fortress city,
        assault_fortress: 60,
        // and on another city.
        assault_city: 20,
        // The most a bystander cares when a fortress is taken,
        fortress_taken: 20,
        // and when a wizard is destroyed.
        wizard_destroyed: 40,
        // An enchantment in force moves the feeling each turn by its value divided by this (above 0),
        ongoing_divisor: 10,
        // the Spell of Mastery being cast by this (above 0).
        mastery_ongoing_divisor: 2,
        // A stronger army is feared when this percent of how many times it is stronger is at most 100,
        army_threshold_pct: 50,
        // by what is missing to 101 divided by this, in hundredths of a point a turn (above 0).
        army_fear_divisor: 2,
        // Too many cities are looked at on every turn that is a multiple of this (above 0).
        overcrowd_every: 2,
        // The surplus of cities is divided by the size of the land plus this, less the difficulty,
        overcrowd_base: 6,
        // times this,
        overcrowd_per: 2,
        // at least this much,
        overcrowd_least: 15,
        // and this many hundredths of that are taken off.
        overcrowd_hundredths: 25,
        // Hundredths of a point a turn for units next to a city without a treaty.
        intruder_hundredths: 12,
        // Turns without a change by the other before the feeling drifts back.
        drift_wait: 1,
        // The drift is faster the nearer the feeling is to 0: nothing this far from it,
        drift_range: 105,
        // this many hundredths of a point a turn at 0.
        drift_most: 50,
        // Downwards it drifts only on every turn that is a multiple of this, this many times as far (above 0).
        drift_down_every: 10,
        // A war that begins puts the feeling this far below 0,
        war_start: 87,
        // and takes this off where it drifts back to.
        war_default_penalty: 5,
        // Added when a war ends in peace.
        peace_gain: 40,
    ),
)
