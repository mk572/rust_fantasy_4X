// Rules settings: the defaults of the new-game choices, the map and land sizes, the difficulty
// levels (starting gold and so on) and the spell library (read by `f4x_data::load_content_layers`,
// optional; `game::setting::SettingsDef` is the schema). The language and the switches of the
// client (animations, sound) are in `client_settings.ron`.
//
// Only settings that exist in the game today are listed. The rest of the design
// (`docs/game-settings.md`: stack limit, starting units and mana, map size, victory conditions and
// so on) is added here when each setting is implemented.

(
    // The choices on the new-game options step and the Game settings screen, as they stand
    // before the player changes anything.
    new_game: (
        difficulty: 2,       // 0 Intro, 1 Easy, 2 Average, 3 Hard, 4 Impossible
        opponents: 1,        // computer wizards, 1 to 9
        land_percent: 30,    // share of each plane's tiles: 15 small, 20 medium, 30 large
        magic_strength: 1,   // nodes: 0 weak, 1 normal, 2 powerful
        diagonal_extra_cost: false, // false: a diagonal step costs the same as a straight one;
                                    // true: it costs 50% more (3 half-moves instead of 2),
                                    // for movement and for sight
        original_map_generator: false, // false: this game's noise-based land;
                                       // true: the original's random-walk continents
    ),

    // Half the upkeep for the basic troops of every race, a divergence inspired by the Caster of
    // Magic mod: about every second spearman or swordsman eats nothing and costs nothing (the
    // ones with an odd serial number, the order the units were made in). Set `enabled: false` for
    // the original's full upkeep, or change `units` (names of the units, the same for every race).
    half_upkeep: (enabled: false, units: ["spearmen", "swordsmen"]),

    // The most computer wizards a new game can have (1 to 9; more wizards need more start
    // positions).
    max_opponents: 9,

    // The land sizes of the options step, smallest first: an id (its words are in `text/<language>/options.ron`) and the share of each plane's
    // tiles that is land.
    land_sizes: [
        (id: "small", land_percent: 15),
        (id: "medium", land_percent: 20),
        (id: "large", land_percent: 30),
    ],

    // The map sizes of the options step, smallest first: an id and the squares across and down
    // of each plane (the original's is 60 by 40, the "Medium"), the towers of wisdom (both planes
    // share them) and the most neutral cities on each plane. The original's 6 and 15 are for 2400
    // squares; the others follow the area. The counts of magic nodes and encounter sites follow
    // the area too. The tested range is 45 to 90 across and 30 to 60 down.
    map_sizes: [
        (id: "small", width: 45, height: 30, towers: 3, neutral_cities: 8),
        (id: "medium", width: 60, height: 40, towers: 6, neutral_cities: 15),
        (id: "large", width: 75, height: 50, towers: 9, neutral_cities: 23),
        (id: "huge", width: 90, height: 60, towers: 14, neutral_cities: 34),
    ],

    // What each difficulty level fills in, from Intro to Extreme (exactly six). Choosing a
    // level at the start of a game copies these into the game's settings. Most figures are the
    // original's (`difficulty_modifiers_table` and the map generator). Notes:
    // - `starting_mana`: mana in the treasury at the start.
    // - `start_reveal_radius`: how far a wizard sees around their capital at the start, in
    //   squares; a diagonal step counts 1.5, so 2.5 is a 5 by 5 block without its corners.
    // - `pressure_percent`: the share of the turns since the last event that count as pressure;
    //   the chance of an event in a turn is the pressure over 512.
    levels: [
        // 0: Intro
        (
            wizards: (
                starting_gold: (human: 125, ai: 150),
                starting_mana: (human: 0, ai: 0),
                picks: (human: 11, ai: 11),
            ),
            ai: (
                growth_percent: 100,
                outpost_growth_percent: 100,
                production_percent: 100,
                gold_percent: 100,
                mana_percent: 100,
                food_percent: 100,
                research_percent: 100,
                maintenance_percent: 100,
                unit_upkeep_percent: 100,
                wizards: (
                    randomise: true,
                    consolidate_percent: 0,
                    erasure_dice: (0, 0),
                    myrran_rule: false,
                    guaranteed_summoning_spell: true,   // a common summoning spell of its main realm is known
                ),
            ),
            world: (
                lair_guard_percent: 25,
                lair_treasure_percent: 400,
                neutral_city_size_bonus: 0,
                raiders_enabled: true,
                monsters_enabled: true,
                raider_percent: 0,
                start_reveal_radius: 2.5,
            ),
            rules: (safe_flee: (human: true, ai: true), settlers_cost_citizen: true, melee_vs_fliers: zero, max_tile: 12), // settlers_cost_citizen: false = Settlers cost no citizen; melee_vs_fliers: zero (original), half, full; max_tile: units on one square, 12 in v1.31 (the original: 9), 9 to 20 (an army and a battle side stay at nine)
            events: (random_events: false, pressure_percent: 50, frequency: Normal),
            scoring: (score_percent: 50),
        ),
        // 1: Easy
        (
            wizards: (
                starting_gold: (human: 100, ai: 150),
                starting_mana: (human: 0, ai: 0),
                picks: (human: 11, ai: 11),
            ),
            ai: (
                growth_percent: 100,
                outpost_growth_percent: 100,
                production_percent: 125,
                gold_percent: 125,
                mana_percent: 125,
                food_percent: 125,
                research_percent: 100,
                maintenance_percent: 90,
                unit_upkeep_percent: 100,
                wizards: (
                    randomise: true,
                    consolidate_percent: 0,
                    erasure_dice: (0, 0),
                    myrran_rule: false,
                    guaranteed_summoning_spell: true,   // a common summoning spell of its main realm is known
                ),
            ),
            world: (
                lair_guard_percent: 50,
                lair_treasure_percent: 200,
                neutral_city_size_bonus: 0,
                raiders_enabled: true,
                monsters_enabled: true,
                raider_percent: 17,
                start_reveal_radius: 2.5,
            ),
            rules: (safe_flee: (human: true, ai: true), settlers_cost_citizen: true, melee_vs_fliers: zero, max_tile: 12), // settlers_cost_citizen: false = Settlers cost no citizen; melee_vs_fliers: zero (original), half, full; max_tile: units on one square, 12 in v1.31 (the original: 9), 9 to 20 (an army and a battle side stay at nine)
            events: (random_events: true, pressure_percent: 66, frequency: Normal),
            scoring: (score_percent: 75),
        ),
        // 2: Average
        (
            wizards: (
                starting_gold: (human: 75, ai: 150),
                starting_mana: (human: 0, ai: 0),
                picks: (human: 11, ai: 11),
            ),
            ai: (
                growth_percent: 150,
                outpost_growth_percent: 150,
                production_percent: 150,
                gold_percent: 150,
                mana_percent: 150,
                food_percent: 150,
                research_percent: 100,
                maintenance_percent: 75,
                unit_upkeep_percent: 100,
                wizards: (
                    randomise: true,
                    consolidate_percent: 0,
                    erasure_dice: (1, 3),
                    myrran_rule: false,
                    guaranteed_summoning_spell: true,   // a common summoning spell of its main realm is known
                ),
            ),
            world: (
                lair_guard_percent: 75,
                lair_treasure_percent: 133,
                neutral_city_size_bonus: 1,
                raiders_enabled: true,
                monsters_enabled: true,
                raider_percent: 33,
                start_reveal_radius: 2.5,
            ),
            rules: (safe_flee: (human: false, ai: false), settlers_cost_citizen: true, melee_vs_fliers: zero, max_tile: 12), // settlers_cost_citizen: false = Settlers cost no citizen; melee_vs_fliers: zero (original), half, full; max_tile: units on one square, 12 in v1.31 (the original: 9), 9 to 20 (an army and a battle side stay at nine)
            events: (random_events: true, pressure_percent: 75, frequency: Normal),
            scoring: (score_percent: 100),
        ),
        // 3: Hard
        (
            wizards: (
                starting_gold: (human: 50, ai: 150),
                starting_mana: (human: 0, ai: 0),
                picks: (human: 11, ai: 13),
            ),
            ai: (
                growth_percent: 200,
                outpost_growth_percent: 200,
                production_percent: 200,
                gold_percent: 200,
                mana_percent: 200,
                food_percent: 200,
                research_percent: 110,
                maintenance_percent: 60,
                unit_upkeep_percent: 75,
                wizards: (
                    randomise: true,
                    consolidate_percent: 20,
                    erasure_dice: (2, 3),
                    myrran_rule: true,
                    guaranteed_summoning_spell: true,   // a common summoning spell of its main realm is known
                ),
            ),
            world: (
                lair_guard_percent: 100,
                lair_treasure_percent: 100,
                neutral_city_size_bonus: 1,
                raiders_enabled: true,
                monsters_enabled: true,
                raider_percent: 50,
                start_reveal_radius: 2.5,
            ),
            rules: (safe_flee: (human: false, ai: false), settlers_cost_citizen: true, melee_vs_fliers: zero, max_tile: 12), // settlers_cost_citizen: false = Settlers cost no citizen; melee_vs_fliers: zero (original), half, full; max_tile: units on one square, 12 in v1.31 (the original: 9), 9 to 20 (an army and a battle side stay at nine)
            events: (random_events: true, pressure_percent: 80, frequency: Normal),
            scoring: (score_percent: 200),
        ),
        // 4: Impossible
        (
            wizards: (
                starting_gold: (human: 25, ai: 150),
                starting_mana: (human: 0, ai: 0),
                picks: (human: 11, ai: 15),
            ),
            ai: (
                growth_percent: 400,
                outpost_growth_percent: 400,
                production_percent: 400,
                gold_percent: 400,
                mana_percent: 400,
                food_percent: 400,
                research_percent: 150,
                maintenance_percent: 30,
                unit_upkeep_percent: 50,
                wizards: (
                    randomise: true,
                    consolidate_percent: 20,
                    erasure_dice: (2, 5),
                    myrran_rule: true,
                    guaranteed_summoning_spell: true,   // a common summoning spell of its main realm is known
                ),
            ),
            world: (
                lair_guard_percent: 125,
                lair_treasure_percent: 100,
                neutral_city_size_bonus: 1,
                raiders_enabled: true,
                monsters_enabled: true,
                raider_percent: 67,
                start_reveal_radius: 2.5,
            ),
            rules: (safe_flee: (human: false, ai: false), settlers_cost_citizen: true, melee_vs_fliers: zero, max_tile: 12), // settlers_cost_citizen: false = Settlers cost no citizen; melee_vs_fliers: zero (original), half, full; max_tile: units on one square, 12 in v1.31 (the original: 9), 9 to 20 (an army and a battle side stay at nine)
            events: (random_events: true, pressure_percent: 100, frequency: Normal),
            scoring: (score_percent: 300),
        ),
        // 5: Extreme (patch 1.40). Provisional: the same figures as Impossible until the patch's own are
        // read from its notes (task 530). Choosing it in a new game plays the v1.6 rule set.
        (
            wizards: (
                starting_gold: (human: 25, ai: 150),
                starting_mana: (human: 0, ai: 0),
                picks: (human: 11, ai: 15),
            ),
            ai: (
                growth_percent: 400,
                outpost_growth_percent: 400,
                production_percent: 400,
                gold_percent: 400,
                mana_percent: 400,
                food_percent: 400,
                research_percent: 150,
                maintenance_percent: 30,
                unit_upkeep_percent: 50,
                wizards: (
                    randomise: true,
                    consolidate_percent: 20,
                    erasure_dice: (2, 5),
                    myrran_rule: true,
                    guaranteed_summoning_spell: true,   // a common summoning spell of its main realm is known
                ),
            ),
            world: (
                lair_guard_percent: 125,
                lair_treasure_percent: 100,
                neutral_city_size_bonus: 1,
                raiders_enabled: true,
                monsters_enabled: true,
                raider_percent: 67,
                start_reveal_radius: 2.5,
            ),
            rules: (safe_flee: (human: false, ai: false), settlers_cost_citizen: true, melee_vs_fliers: zero, max_tile: 12), // settlers_cost_citizen: false = Settlers cost no citizen; melee_vs_fliers: zero (original), half, full; max_tile: units on one square, 12 in v1.31 (the original: 9), 9 to 20 (an army and a battle side stay at nine)
            events: (random_events: true, pressure_percent: 100, frequency: Normal),
            scoring: (score_percent: 300),
        ),
    ],

    // What a new wizard knows and may research (the original's spell library set-up, `INITGAME.c`
    // `Init_Computer_Players_Spell_Library` and `NewGame.c`). The three tables have twelve rows,
    // one for each number of books in a realm, 0 to 11. A count above the number of spells the
    // realm has means all of them.
    spell_library: (
        // Spells of the realm the wizard knows at the start: the ones chosen at creation first,
        // then the realm's default list (`realms.ron`) in order. 2 to 10 books: books - 1
        // commons. 11 books: all ten commons, two uncommon and one rare.
        known: [
            (common: 0, uncommon: 0, rare: 0, very_rare: 0),   // 0 books
            (common: 0, uncommon: 0, rare: 0, very_rare: 0),   // 1
            (common: 1, uncommon: 0, rare: 0, very_rare: 0),   // 2
            (common: 2, uncommon: 0, rare: 0, very_rare: 0),   // 3
            (common: 3, uncommon: 0, rare: 0, very_rare: 0),   // 4
            (common: 4, uncommon: 0, rare: 0, very_rare: 0),   // 5
            (common: 5, uncommon: 0, rare: 0, very_rare: 0),   // 6
            (common: 6, uncommon: 0, rare: 0, very_rare: 0),   // 7
            (common: 7, uncommon: 0, rare: 0, very_rare: 0),   // 8
            (common: 8, uncommon: 0, rare: 0, very_rare: 0),   // 9
            (common: 9, uncommon: 0, rare: 0, very_rare: 0),   // 10
            (common: 10, uncommon: 2, rare: 1, very_rare: 0),  // 11
        ],
        // Spells of the realm the wizard may research (the known ones count), drawn at random.
        // More than 7 books open every uncommon spell, more than 9 every rare and very rare one.
        researchable: [
            (common: 0, uncommon: 0, rare: 0, very_rare: 0),    // 0 books
            (common: 3, uncommon: 1, rare: 0, very_rare: 0),    // 1
            (common: 5, uncommon: 2, rare: 1, very_rare: 0),    // 2
            (common: 6, uncommon: 3, rare: 2, very_rare: 1),    // 3
            (common: 7, uncommon: 4, rare: 3, very_rare: 2),    // 4
            (common: 8, uncommon: 5, rare: 4, very_rare: 3),    // 5
            (common: 9, uncommon: 6, rare: 5, very_rare: 4),    // 6
            (common: 10, uncommon: 8, rare: 6, very_rare: 5),   // 7
            (common: 10, uncommon: 99, rare: 7, very_rare: 6),  // 8
            (common: 10, uncommon: 99, rare: 9, very_rare: 7),  // 9
            (common: 10, uncommon: 99, rare: 99, very_rare: 99), // 10
            (common: 99, uncommon: 99, rare: 99, very_rare: 99), // 11
        ],
        // Spells of the realm the wizard chooses on the creation screen. The rest of `known`
        // are taken from the realm's default list.
        chosen: [
            (common: 0, uncommon: 0, rare: 0, very_rare: 0),   // 0 books
            (common: 0, uncommon: 0, rare: 0, very_rare: 0),   // 1
            (common: 1, uncommon: 0, rare: 0, very_rare: 0),   // 2
            (common: 2, uncommon: 0, rare: 0, very_rare: 0),   // 3
            (common: 3, uncommon: 0, rare: 0, very_rare: 0),   // 4
            (common: 4, uncommon: 0, rare: 0, very_rare: 0),   // 5
            (common: 5, uncommon: 0, rare: 0, very_rare: 0),   // 6
            (common: 6, uncommon: 0, rare: 0, very_rare: 0),   // 7
            (common: 7, uncommon: 0, rare: 0, very_rare: 0),   // 8
            (common: 8, uncommon: 0, rare: 0, very_rare: 0),   // 9
            (common: 9, uncommon: 0, rare: 0, very_rare: 0),   // 10
            (common: 0, uncommon: 2, rare: 1, very_rare: 0),   // 11
        ],
        // Spells every wizard knows at the start (spell ids).
        always_known: [201, 214],
        // Spells a retort gives at the start.
        retort_known: {
            17: [207, 211],
        },
        // Arcane spells nobody may research at the start. (Spell of Mastery is offered last, when
        // nothing else is left to research; Spell of Return is known.)
        arcane_closed: [213, 214],
        // A computer wizard also knows this spell of its main realm (the realm with most books;
        // the first of the realms on a tie). The original's code names Water Walking, Counter
        // Magic, Fire Bolt, True Light and Black Sleep here, but its table is off by one spell
        // and really gives these. Leave it empty for no such spell.
        ai_main_realm_known: {
            0: 9,
            1: 49,
            2: 84,
            3: 129,
            4: 166,
        },
        // From the difficulty `ai_main_realm_researchable_from` on (3 is Hard), a computer
        // wizard may also research this spell of its main realm. The original's code checks the
        // wrong spell before adding it (`OGBUG`), so it does so on every level from Hard; the
        // wiki lists these as the spells it means.
        ai_main_realm_researchable_from: 3,
        ai_main_realm_researchable: {
            0: 20,
            1: 60,
            2: 100,
            3: 136,
            4: 180,
        },
        // Patch 1.40 of the original: while another realm has spells to research, at most this
        // many arcane spells are on offer at once (the patch uses 4). 0 is off, as in the
        // original game.
        arcane_candidate_cap: 0,
    ),
)
