// Terrain definitions. `class` drives map generation; at least one definition
// per class and plane is required (checked by `f4x-tools validate`).
// `food` is in half-food units (3 = one and a half food) and sets how many citizens a
// city's land can feed; `production_percent` is added to a city's production per tile.
[
    (id: "ocean", num: 8,     class: Ocean,     walkable: false, can_found_city: false, move_cost: 0, food: 0, production_percent: 0, planes: [Arcanus, Myrror]),
    (id: "grassland", num: 4, class: Grassland, walkable: true,  can_found_city: true,  move_cost: 1, food: 3, production_percent: 0, planes: [Arcanus, Myrror]),
    (id: "forest", num: 3,    class: Forest,    walkable: true,  can_found_city: true,  move_cost: 2, food: 1, production_percent: 3, planes: [Arcanus, Myrror]),
    (id: "hills", num: 5,     class: Hills,     walkable: true,  can_found_city: true,  move_cost: 3, food: 1, production_percent: 3, planes: [Arcanus, Myrror]),
    (id: "mountains", num: 6, class: Mountains, walkable: true,  can_found_city: false,  move_cost: 4, food: 0, production_percent: 5, planes: [Arcanus, Myrror]),
    (id: "swamp", num: 10,     class: Swamp,     walkable: true,  can_found_city: true,  move_cost: 3, food: 1, production_percent: 0, planes: [Arcanus, Myrror]),
    (id: "desert", num: 2,    class: Desert,    walkable: true,  can_found_city: true,  move_cost: 1, food: 0, production_percent: 3, planes: [Arcanus, Myrror]),
    (id: "tundra", num: 11,    class: Tundra,    walkable: true,  can_found_city: true,  move_cost: 2, food: 0, production_percent: 0, planes: [Arcanus, Myrror]),
    // The base terrain of a node's square, as the original's tt_SorceryNode, tt_NatureNode and
    // tt_ChaosNode (food and production from Square_Food_x2 and Square_Production_Bonus; the
    // nature node's food is 5, see divergences.md; movement cost as TERRSTAT.LBX: grassland,
    // forest and mountains). A city may not stand on one: the node feature refuses it.
    (id: "sorcery_node", num: 9, class: SorceryNode, walkable: true, can_found_city: true, move_cost: 1, food: 4, production_percent: 0, planes: [Arcanus, Myrror]),
    (id: "nature_node", num: 7,  class: NatureNode,  walkable: true, can_found_city: true, move_cost: 2, food: 5, production_percent: 3, planes: [Arcanus, Myrror]),
    (id: "chaos_node", num: 1,   class: ChaosNode,   walkable: true, can_found_city: true, move_cost: 4, food: 0, production_percent: 5, planes: [Arcanus, Myrror]),
]
