/target
/crates/f4x-ai-ref
/assets-local
/assets-unused
*.lbx
*.LBX
/content-local
__pycache__/
/reference
/saves
/settings
/scripts/thermal_state
/.venv
/tools/*/target
# The learning tool's checkpoints and scenario banks, and what its tests save.
/tools/f4x-learn/models-local
/tools/f4x-learn/tests/saves/*
!/tools/f4x-learn/tests/saves/.gitkeep
.DS_Store
/soak-out
# Runtime logs and other temporary output of scripts and checks.
/log/
/outputs/

# What the tests save is theirs to leave behind; the folder itself stays.
/crates/*/tests/saves/*
!/crates/*/tests/saves/.gitkeep
# The fresh games core's tests load (`f4x-newgame/tests/it/fixtures.rs` keeps them current).
!/crates/f4x-core/tests/saves/fresh_*.save
!/crates/f4x-core/tests/saves/fresh_*.rng

# Local soak baselines and the archived docs
/docs/soak-baseline.md
/docs/archive/
/duel-out
