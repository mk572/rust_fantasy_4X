// Abilities with no effects are flags: the combat and movement code checks for the
// id. Abilities with effects get their modifiers applied through the stats engine.
[
    (id: "first_strike",  name: "First Strike",  description: "Strikes before the enemy in melee.", effects: []),
    (id: "flying",        name: "Flying",        description: "Ignores terrain movement costs.",    effects: []),
    (id: "fire_immunity", name: "Fire Immunity", description: "Takes no fire damage.",              effects: []),
    (id: "armoured", name: "Armoured", description: "Heavy armour.", effects: [
        (effect: Modify(stat: Defense, op: Add, value: 1)),
    ]),
    (id: "regeneration", name: "Regeneration", description: "Heals each turn.", effects: [
        (when: OnTurnStart, effect: Heal(2)),
    ]),
]
