// Kept by hand (the importer no longer writes this file).
// The original has no table of unit abilities (most are flag bits, the rest attack-type fields),
// so `num` is our own: 1, 2, 3 ... in the alphabetical order of the ids. A new ability is
// inserted in its alphabetical place and the rows after it move up one (saved games name abilities
// by id, so they are not affected). `id` is the alias for human editing.
[
    (num: 1, id: "armor_piercing", name: "Armour Piercing", description: "Halves the target's defence.", effects: []),
    (num: 2, id: "asleep", name: "Asleep", description: "Cannot move, attack or fly; every blow against it does full damage.", effects: []),
