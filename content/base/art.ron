// Presentation data. Keys are "<kind>:<id>". A sprite is a file under this pack's
// `art/` directory, for example:
//
//   (key: "unit:spearman",
//    sprite: Some((file: "units/spearman.png", frames: 4, frame_size: Some((32, 32)), fps: 6)),
//    icon: Some((file: "icons/spearman.png")),
//    color: Some((200, 190, 120))),
//
// `color` is the flat fallback drawn when the image is missing, so every entry
// below works without any image files.
[
    (key: "terrain:ocean",     color: Some((30, 60, 140))),
    (key: "terrain:grassland", color: Some((90, 170, 70))),
    (key: "terrain:forest",    color: Some((30, 110, 50))),
    (key: "terrain:hills",     color: Some((150, 130, 80))),
    (key: "terrain:mountains", color: Some((130, 130, 140))),
    (key: "terrain:swamp",     color: Some((80, 100, 70))),
    (key: "terrain:desert",    color: Some((220, 200, 120))),
    (key: "terrain:tundra",    color: Some((220, 230, 240))),

    (key: "feature:tower",       color: Some((240, 240, 240))),
