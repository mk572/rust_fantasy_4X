// Map features: overlays on top of base terrain (one per tile).
//
// A spawn rule says: on these terrain classes, on these planes, spawn with this
// relative weight. Weights are relative among all features of the same kind that
// match one (terrain class, plane). Mineral numbers are modelled on the original
// game's mineral tables as documented by community clones; they are starting
// values to tune, not rules. Myrror differs from Arcanus in mineral mix
// (adamantium, crysx, more gold/mithril/quork) and, see GenParams, in density.
[
    // ---- Minerals and specials ------------------------------------------------
    (id: "wild_game", name: "Wild Game", kind: Mineral, spawn: [
        (terrain: [Forest], planes: [Arcanus, Myrror], weight: 100),
    ]),
    (id: "nightshade", name: "Nightshade", kind: Mineral, spawn: [
        (terrain: [Swamp], planes: [Arcanus, Myrror], weight: 100),
    ]),
    (id: "iron_ore", name: "Iron Ore", kind: Mineral, spawn: [
        (terrain: [Hills],     planes: [Arcanus], weight: 200),
        (terrain: [Mountains], planes: [Arcanus], weight: 133),
        (terrain: [Hills, Mountains], planes: [Myrror], weight: 10),
    ]),
    (id: "coal", name: "Coal", kind: Mineral, spawn: [
        (terrain: [Hills],     planes: [Arcanus], weight: 100),
        (terrain: [Mountains], planes: [Arcanus], weight: 167),
        (terrain: [Hills, Mountains], planes: [Myrror], weight: 10),
    ]),
    (id: "silver_ore", name: "Silver Ore", kind: Mineral, spawn: [
        (terrain: [Hills],     planes: [Arcanus], weight: 133),
        (terrain: [Mountains], planes: [Arcanus], weight: 100),
        (terrain: [Hills, Mountains], planes: [Myrror], weight: 10),
    ]),
    (id: "gold_ore", name: "Gold Ore", kind: Mineral, spawn: [
        (terrain: [Hills],     planes: [Arcanus], weight: 133),
        (terrain: [Mountains], planes: [Arcanus], weight: 100),
        (terrain: [Hills],     planes: [Myrror],  weight: 40),
        (terrain: [Mountains], planes: [Myrror],  weight: 20),
    ]),
    (id: "mithril_ore", name: "Mithril Ore", kind: Mineral, spawn: [
        (terrain: [Hills],     planes: [Arcanus], weight: 33),
        (terrain: [Mountains], planes: [Arcanus], weight: 100),
        (terrain: [Hills],     planes: [Myrror],  weight: 20),
        (terrain: [Mountains], planes: [Myrror],  weight: 30),
    ]),
    // Myrror only.
    (id: "adamantium_ore", name: "Adamantium Ore", kind: Mineral, spawn: [
        (terrain: [Hills],     planes: [Myrror], weight: 10),
        (terrain: [Mountains], planes: [Myrror], weight: 20),
    ]),
    (id: "gem", name: "Gems", kind: Mineral, spawn: [
        (terrain: [Desert], planes: [Arcanus], weight: 67),
        (terrain: [Desert], planes: [Myrror],  weight: 20),
    ]),
    (id: "quork_crystal", name: "Quork Crystal", kind: Mineral, spawn: [
        (terrain: [Desert], planes: [Arcanus], weight: 33),
        (terrain: [Desert], planes: [Myrror],  weight: 60),
    ]),
    // Myrror only.
    (id: "crysx_crystal", name: "Crysx Crystal", kind: Mineral, spawn: [
        (terrain: [Desert], planes: [Myrror], weight: 20),
    ]),

    // ---- Encounter sites -------------------------------------------------------
    (id: "monster_lair",    name: "Monster Lair",    kind: Encounter, spawn: [(terrain: [Grassland, Forest, Hills, Mountains, Swamp, Desert, Tundra], planes: [Arcanus, Myrror], weight: 10)]),
    (id: "mysterious_cave", name: "Mysterious Cave", kind: Encounter, spawn: [(terrain: [Grassland, Forest, Hills, Mountains, Swamp, Desert, Tundra], planes: [Arcanus, Myrror], weight: 10)]),
    (id: "ancient_temple",  name: "Ancient Temple",  kind: Encounter, spawn: [(terrain: [Grassland, Forest, Hills, Mountains, Swamp, Desert, Tundra], planes: [Arcanus, Myrror], weight: 10)]),
    (id: "fallen_temple",   name: "Fallen Temple",   kind: Encounter, spawn: [(terrain: [Grassland, Forest, Hills, Mountains, Swamp, Desert, Tundra], planes: [Arcanus, Myrror], weight: 10)]),
    (id: "ruins",           name: "Ruins",           kind: Encounter, spawn: [(terrain: [Grassland, Forest, Hills, Mountains, Swamp, Desert, Tundra], planes: [Arcanus, Myrror], weight: 10)]),
    (id: "abandoned_keep",  name: "Abandoned Keep",  kind: Encounter, spawn: [(terrain: [Grassland, Forest, Hills, Mountains, Swamp, Desert, Tundra], planes: [Arcanus, Myrror], weight: 10)]),
    (id: "dungeon",         name: "Dungeon",         kind: Encounter, spawn: [(terrain: [Grassland, Forest, Hills, Mountains, Swamp, Desert, Tundra], planes: [Arcanus, Myrror], weight: 10)]),

    // ---- Tower: one per site, same coordinates on every plane ------------------
    (id: "tower", name: "Tower", kind: Tower),

    // ---- Magic nodes: type follows the surrounding terrain ---------------------
    (id: "nature_node", name: "Nature Node", kind: Node, spawn: [
        (terrain: [Forest, Swamp],  planes: [Arcanus, Myrror], weight: 4),
        (terrain: [Grassland],      planes: [Arcanus, Myrror], weight: 1),
    ]),
    (id: "sorcery_node", name: "Sorcery Node", kind: Node, spawn: [
        (terrain: [Grassland, Tundra, Desert], planes: [Arcanus, Myrror], weight: 4),
        (terrain: [Forest, Swamp, Hills],      planes: [Arcanus, Myrror], weight: 1),
    ]),
    (id: "chaos_node", name: "Chaos Node", kind: Node, spawn: [
        (terrain: [Mountains, Hills], planes: [Arcanus, Myrror], weight: 4),
        (terrain: [Desert, Swamp],    planes: [Arcanus, Myrror], weight: 2),
    ]),
]
