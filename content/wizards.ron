// The ready-made wizards: which books and retort each has. Their order is the order of their
// portraits. The names, descriptions and portrait art are the original's and are local-only
// (`content-local/wizard_texts.ron`, from `scripts/import_mom.py`); without them a wizard is named
// after its id. Lo Pan has four sorcery books, one fewer than the original (docs/divergences.md).
[
    (id: "merlin", gender: Masculine, books: [("life", 5), ("nature", 5)], retorts: [SageMaster]),
    (id: "raven", gender: Masculine, books: [("sorcery", 6), ("nature", 5)], retorts: []),
    (id: "sharee", gender: Feminine, books: [("death", 5), ("chaos", 5)], retorts: [Conjurer]),
    (id: "lo_pan", gender: Masculine, books: [("sorcery", 4), ("chaos", 5)], retorts: [Channeler]),
    (id: "jafar", gender: Masculine, books: [("sorcery", 10)], retorts: [Alchemy]),
    (id: "oberic", gender: Masculine, books: [("nature", 5), ("chaos", 5)], retorts: [ManaFocusing]),
    (id: "rjak", gender: Neuter, books: [("death", 9)], retorts: [InfernalPower]),
    (id: "sssra", gender: Masculine, books: [("life", 4), ("chaos", 4)], retorts: [Myrran]),
    (id: "tauron", gender: Masculine, books: [("chaos", 10)], retorts: [ChaosMastery]),
    (id: "freya", gender: Feminine, books: [("nature", 10)], retorts: [NatureMastery]),
    (id: "horus", gender: Masculine, books: [("life", 5), ("sorcery", 5)], retorts: [Archmage]),
    (id: "ariel", gender: Feminine, books: [("life", 10)], retorts: [Charismatic]),
    (id: "tlaloc", gender: Masculine, books: [("nature", 4), ("death", 5)], retorts: [Warlord]),
    (id: "kali", gender: Feminine, books: [("sorcery", 5), ("death", 5)], retorts: [Artificer]),
]
