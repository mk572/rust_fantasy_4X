// The ready-made wizards: which books and retort each has. Their order is the order of their
// portraits. The names are in `text/en/name/wizard.ron`; the help text of each is the topic named by
// its `help` (an index in `help.ron`, ours). Portrait art is the original's and local-only. Lo Pan has four sorcery
// books, one fewer than the original (docs/divergences.md).
// `num` is the wizard's place in the original's list (the portrait order); `id` is the alias for human editing.
[
    (num: 0, id: "merlin", help: 659, gender: Masculine, books: [(3, 5), (0, 5)], retorts: [7]),
    (num: 1, id: "raven", help: 660, gender: Masculine, books: [(1, 6), (0, 5)], retorts: []),
    (num: 2, id: "sharee", help: 661, gender: Feminine, books: [(4, 5), (2, 5)], retorts: [15]),
    (num: 3, id: "lo_pan", help: 662, gender: Masculine, books: [(1, 4), (2, 5)], retorts: [8]),
    (num: 4, id: "jafar", help: 663, gender: Masculine, books: [(1, 10)], retorts: [0]),
    (num: 5, id: "oberic", help: 664, gender: Masculine, books: [(0, 5), (2, 5)], retorts: [11]),
    (num: 6, id: "rjak", help: 667, gender: Neuter, books: [(4, 9)], retorts: [5]),
    (num: 7, id: "sssra", help: 666, gender: Masculine, books: [(3, 4), (2, 4)], retorts: [9]),
    (num: 8, id: "tauron", help: 665, gender: Masculine, books: [(2, 10)], retorts: [2]),
    (num: 9, id: "freya", help: 668, gender: Feminine, books: [(0, 10)], retorts: [3]),
    (num: 10, id: "horus", help: 669, gender: Masculine, books: [(3, 5), (1, 5)], retorts: [10]),
    (num: 11, id: "ariel", help: 670, gender: Feminine, books: [(3, 10)], retorts: [16]),
    (num: 12, id: "tlaloc", help: 671, gender: Masculine, books: [(0, 4), (4, 5)], retorts: [1]),
    (num: 13, id: "kali", help: 672, gender: Feminine, books: [(1, 5), (4, 5)], retorts: [17]),
]
