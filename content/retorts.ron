// The wizard's special abilities ("retorts" in the original's manual). Kept by hand.
// `num` is the original's place in its wizard record (alchemy 0 ... artificer 17), the id the game
// passes around and the saved game writes; `id` is the alias for human editing; the name shown is in
// content/text/en/name/retort.ron, by `num`.
// `cost`: the picks it takes at the creation screen. `requires`: what the books must be before it
// may be picked: `Books(realm, min)` is `min` books in that realm; `Realms(count, min)` is `count`
// realms with at least `min` books each.
[
    (num: 0, id: "alchemy", help: Some(693), cost: 1, requires: []),
    (num: 1, id: "warlord", help: Some(694), cost: 2, requires: []),
    (num: 2, id: "chaos_mastery", help: Some(705), cost: 1, requires: [Books(2, 4)]),
    (num: 3, id: "nature_mastery", help: Some(706), cost: 1, requires: [Books(0, 4)]),
    (num: 4, id: "sorcery_mastery", help: Some(707), cost: 1, requires: [Books(1, 4)]),
    (num: 5, id: "infernal_power", help: Some(708), cost: 2, requires: [Books(4, 4)]),
    (num: 6, id: "divine_power", help: Some(701), cost: 2, requires: [Books(3, 4)]),
    (num: 7, id: "sage_master", help: Some(699), cost: 1, requires: [Realms(2, 1)]),
    (num: 8, id: "channeler", help: Some(695), cost: 2, requires: []),
    (num: 9, id: "myrran", help: Some(700), cost: 3, requires: []),
    (num: 10, id: "archmage", help: Some(696), cost: 1, requires: [Realms(1, 4)]),
    (num: 11, id: "mana_focusing", help: Some(709), cost: 1, requires: [Realms(1, 4)]),
    (num: 12, id: "node_mastery", help: Some(710), cost: 1, requires: [Books(2, 1), Books(1, 1), Books(0, 1)]),
    (num: 13, id: "famous", help: Some(702), cost: 2, requires: []),
    (num: 14, id: "runemaster", help: Some(703), cost: 1, requires: [Realms(3, 2)]),
    (num: 15, id: "conjurer", help: Some(698), cost: 1, requires: []),
    (num: 16, id: "charismatic", help: Some(704), cost: 1, requires: []),
    (num: 17, id: "artificer", help: Some(697), cost: 1, requires: []),
]
