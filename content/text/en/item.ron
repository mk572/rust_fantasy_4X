// Player-facing messages about items. One key is in one file only (docs/text.md).
{
    // A bonus line on an item: "+3 Attack".
    "item.bonus": "+{n} {stat}",
    "item.spell_save": "-{n} Spell Save",
    // A spell charged into an item: "Fire Bolt x 3".
    "item.charges": "{spell} x {n}",
    "item.wrong_slot": "That item cannot be carried in that slot.",
    "item.no_mana": "You do not have the mana to send the item there.",
    "item.would_drown": "This unit will drown if the item is removed.",
    "item.same_location": "Same Location",
    "item.teleport": "Item Teleport",
    "item.transfer_ask": "Sending the item to a hero somewhere else costs {mana} mana. Press Y to do it, N to leave it.",
    // The default name of a made item: "+2 Sword of Strength", "Staff of Fire Bolt x2".
    "item.name_bonus": "+{n} {type}",
    "item.name_of": "{item} of {suffix}",
    "item.name_charges": "{spell} x{n}",
    "item.type_sword": "Sword",
    "item.type_mace": "Mace",
    "item.type_axe": "Axe",
    "item.type_bow": "Bow",
    "item.type_staff": "Staff",
    "item.type_wand": "Wand",
    "item.type_shield": "Shield",
    "item.type_chain_mail": "Chain Mail",
    "item.type_plate_mail": "Plate Mail",
    "item.type_amulet": "Amulet",
    "item.type_ring": "Ring",
    "item.type_cloak": "Cloak",
    "item.type_gauntlet": "Gauntlet",
    "item.type_helm": "Helm",
    "item.type_orb": "Orb",
    "item.suffix_strength": "Strength",
    "item.suffix_accuracy": "Accuracy",
    "item.suffix_defense": "Defense",
    "item.suffix_wizardry": "Wizardry",
    "item.suffix_power": "Power",
    "item.suffix_speed": "Speed",
    "item.suffix_protection": "Protection",
}
