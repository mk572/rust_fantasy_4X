// Player-facing messages of the battle screens. One key is in one file only (docs/text.md).
{
    // Headings of the battle result.
    "battle.triumphant": "Victory is yours",
    "battle.defeated": "Your army has been beaten",
    "battle.retreated": "Your army has withdrawn from the field",
    "battle.opponent_fled": "The enemy has left the field",

    "battle.victory": "Victory!",
    "battle.defeat": "Defeat",
    "battle.monsters": "Monsters",

    // The combat log. `kills` is "battle.figures_lost" or nothing; `taken` is "battle.takes_back" or nothing.
    "battle.hits": "{attacker} hits {defender}: {dealt} damage{kills}{taken}",
    "battle.shoots": "{attacker} shoots {defender}: {dealt} damage{kills}",
    "battle.takes_back": ", takes {n}",
    "battle.figures_lost": (count: "n", one: ", 1 figure lost", other: ", {n} figures lost"),
    "battle.strikes_wall": "{unit} strikes the wall",
    "battle.strikes_wall_falls": "{unit} strikes the wall and it falls",
    "battle.unit_died": "{unit} is destroyed",
    "battle.spell_cast": "{spell} is cast",
    "battle.unit_casts": "{unit} casts {spell}",
    "battle.wall_destroyed": "A section of the wall is destroyed",
    "battle.mud": "The ground turns to mud",
    "battle.fissure": "The earth cracks open",
    "battle.vortex": "A magic vortex appears",
    "battle.life_drained": "{unit} loses {points} life",
    "battle.countered": "Counter Magic stops {spell}",
    "battle.takes_damage": "{unit} takes {dealt} damage{kills}",
    "battle.unharmed": "{unit} is unharmed",
    "battle.healed": "{unit} heals {healed}",
    "battle.enchanted": "{unit} is under {spell}",
    "battle.dispelled": "Dispel on {unit}: {removed} removed",
    "battle.summoned": "{unit} appears",
    "battle.raised": "{unit} rises again as undead",
    "battle.field_dispelled": "{spell} is dispelled from the field",
    "battle.field_raised": "{spell} covers the field",
    "battle.resists": "{unit} resists",
    "battle.spell_slew": (count: "kills",
        one: "{unit} loses 1 figure to the spell",
        other: "{unit} loses {kills} figures to the spell"),
    "battle.terrified": "{unit} cowers in terror",
    "battle.confused_idle": "{unit} stands about, confused",
    "battle.confused_wandered": "{unit} wanders off, confused",
    "battle.confused_seized": "{unit} falls under the enemy's orders",
    "battle.mana_leaked": "Mana drains away",
    "battle.counter_magic": "Counter Magic {strength} stands against spells",
    "battle.turn": "Turn {turn}",
    "battle.fled": "The army flees",
    "battle.recalled": "{unit} is recalled to the summoning circle",

    // The spell book and the aim bar.
    "battle.no_spell": "No spell to cast here",
    "battle.summon_demon": "Summon Demon ({n})",
    "battle.raise_which": "{spell}: raise which unit?   Esc closes",
    "battle.no_fallen": "No fallen unit to raise",
    "battle.fate_drained": "drained",
    "battle.fate_slain": "slain",
    "battle.fallen_row": "{unit}   {figures} figures   {how}",
    "battle.aim_enter": "{spell}: Enter casts",
    "battle.aim_click": "{spell}: click a target",
    "battle.aim_mana": "   mana {mana} (Up/Down, most {most})",
    "battle.aim_cancel": "   Esc cancels",

    "battle.spells_of": "{wizard} Spells",
    "battle.skill": "Skill",
    "battle.mana": "Mana",
    "battle.range": "Range",
    "battle.flee_question": "Do you wish to flee?",
    "battle.hits_label": "Hits",
    "battle.ammo_label": "Ammo",
    "battle.spell_row": "{spell} {cost}",
    "battle.demon_row": "Demon ({n})",
    "battle.side_cast": "{caster} has cast {spell}",
    "battle.unit_cast": (count: "figures",
        one: "The {unit} has cast {spell}",
        other: "The {unit} have cast {spell}"),
}
