// Player-facing messages of the boxes of a guarded or unguarded site (lair, node, tower, ruins).
// One key is in one file only (docs/text.md).
{
    "site.tower.found": "You have found a tower.",
    "site.tower.name": "tower",
    "site.chaos_node.found": "You have found a chaos node.",
    "site.chaos_node.name": "chaos node",
    "site.nature_node.found": "You have found a nature node.",
    "site.nature_node.name": "nature node",
    "site.sorcery_node.found": "You have found a sorcery node.",
    "site.sorcery_node.name": "sorcery node",
    "site.mysterious_cave.found": "You have found a mysterious cave.",
    "site.mysterious_cave.name": "mysterious cave",
    "site.dungeon.found": "You have found a dungeon.",
    "site.dungeon.name": "dungeon",
    "site.ancient_temple.found": "You have found an ancient temple.",
    "site.ancient_temple.name": "ancient temple",
    "site.abandoned_keep.found": "You have found an abandoned keep.",
    "site.abandoned_keep.name": "abandoned keep",
    "site.monster_lair.found": "You have found a monster lair.",
    "site.monster_lair.name": "monster lair",
    "site.ruins.found": "You have found some ruins.",
    "site.ruins.name": "ruins",
    "site.fallen_temple.found": "You have found a fallen temple.",
    "site.fallen_temple.name": "fallen temple",

    // What the scouts saw, and the question. `figures` is how many of the unit stand guard.
    "site.ask": (count: "figures",
        one: "{found}  Scouts have spotted a single {unit} within the {site}.  Do you wish to enter?",
        other: "{found}  Scouts have spotted {unit} within the {site}.  Do you wish to enter?"),

    // The treasure box: a list of what was found.
    "site.treasure": "Inside you find {things}.",
    "site.nothing": "Inside you find absolutely nothing.",
    "site.gold": "{n} gold",
    "site.mana": "{n} mana crystals",
    "site.prisoner": "a prisoner",
    "site.spell": "the spell {spell}",
    "site.books": (count: "n", one: "{n} {realm} spell book", other: "{n} {realm} spell books"),
    "site.retort": "a retort of {retort}",
    "site.item.sword": "a Sword",
    "site.item.mace": "a Mace",
    "site.item.axe": "an Axe",
    "site.item.bow": "a Bow",
    "site.item.staff": "a Staff",
    "site.item.wand": "a Wand",
    "site.item.jewelry": "a piece of Jewelry",
    "site.item.shield": "a Shield",
    "site.item.chainmail": "some Chainmail",
    "site.item.platemail": "some Platemail",
}
