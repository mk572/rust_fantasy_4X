// The lines of the message log under the map, one for each event the player is told about.
// One key is in one file only (docs/text.md).
{
    "log.city_number": "City {n}",
    "log.founded": "Founded {city}",
    "log.a_rival": "a rival",
    "log.a_hero": "A hero",
    "log.items_awarded": (count: "lost",
        zero: "Items fall to the victor: {items}",
        other: "Items fall to the victor: {items} ({lost} did not fit the armory and are lost)"),
    "log.production_complete": "{city}: {item} complete",
    "log.rift": "The chaos rift over {city} strikes",
    "log.rift_units": (count: "units",
        one: "The chaos rift over {city} strikes: 1 unit destroyed",
        other: "The chaos rift over {city} strikes: {units} units destroyed"),
    "log.rift_building": "The chaos rift over {city} strikes, {building} falls",
    "log.rift_units_building": (count: "units",
        one: "The chaos rift over {city} strikes: 1 unit destroyed, {building} falls",
        other: "The chaos rift over {city} strikes: {units} units destroyed, {building} falls"),
    "log.city_grew": "{city} grows to {figures}",
    "log.city_shrank": "{city} shrinks to {figures}",
    "log.units_disbanded": (count: "n",
        one: "1 unit disbanded: unpaid or unfed",
        other: "{n} units disbanded: unpaid or unfed"),
    "log.city_looted": "{city} falls: {gold} gold looted, {citizens} citizens and {buildings} buildings lost",
    "log.city_looted_yours": "{city} is yours: {gold} gold looted, {citizens} citizens and {buildings} buildings lost",
    "log.city_razed": "The city is razed: {gold} gold looted",
    "log.city_destroyed": "A city is destroyed",
    "log.banished_you": "Your fortress has fallen! You are banished and cast the Spell of Return",
    "log.banished_rival": "A rival wizard is banished",
    "log.returned": "You have returned to your fortress",
    "log.wizard_defeated": "{wizard} is defeated",
    "log.fortress_moved": "The fortress has moved",
    "log.units_drowned": (count: "n",
        one: "1 unit drowns without a ship",
        other: "{n} units drown without a ship"),
    "log.road_built": "A road square is finished",
    "log.roads_enchanted": "The roads are enchanted",
    "log.volcano_raised": "A volcano rises",
    "log.node_melded": "The spirit melds with the node",
    "log.meld_failed": "The Guardian Spirit in this node kills your spirit",
    "log.buildings_collapsed": (count: "n",
        one: "1 building collapses",
        other: "{n} buildings collapse"),
    "log.terrain_changed": "The land changes",
    "log.circle_moved": "The summoning circle has moved",
    "log.learned": "Learned {spell}",
    "log.cast": "Cast {spell}",
    "log.fizzled_nightshade": "{spell} fizzles: nightshade protects {city}",
    "log.suppressed": "{spell} is stopped by the Suppress Magic of {wizard}",
    "log.power_drained": "Drain Power takes {amount} mana from {wizard}",
    "log.skill_destroyed": "{wizard} loses {amount} points of casting skill for good",
    "log.units_slain": (count: "n",
        one: "{spell} slays 1 unit",
        other: "{spell} slays {n} units"),
    "log.unit_transformed": "{from} becomes {to}",
    "log.earthquake": "The earthquake kills {units} units and destroys {buildings} buildings",
    "log.mastery_started": "{wizard} has started casting the Spell of Mastery",
    "log.stasis_ended": "A unit breaks free of stasis",
    "log.unit_mutated": "The unit is mutated by chaos",
    "log.world_spell_struck": "{spell} kills {units} units and {citizens} citizens and destroys {buildings} buildings",
    "log.spell_blasted": "Spell Blast ends the {spell} of {wizard} ({mana} mana)",
    "log.global_removed": "The {spell} of {wizard} is ended",
    "log.global_taken": "Took the {spell} of {wizard}",
    "log.dispel_failed": "The dispel of {spell} fails",
    "log.dispelled": (count: "n",
        one: "1 enchantment dispelled",
        other: "{n} enchantments dispelled"),
    "log.spell_ready": "{spell} is ready: choose its target (S reopens the choice)",
    "log.hero_joined": "{hero} joins your army",
    "log.hero_spell_failed": "{spell} finds no hero to bring",
    "log.no_effect_yet": "{spell} has no effect yet (not implemented)",
    "log.lapsed": "{spell} ended: not enough mana for its upkeep",

    // What a cleared site gave.
    "log.loot_gold": "{n} gold",
    "log.loot_mana": "{n} mana",
    "log.loot_items": (count: "n", one: "1 magic item", other: "{n} magic items"),
    "log.loot_prisoner": "a prisoner",
    "log.loot_spell": "a spell",
    "log.loot_book": "a {realm} book",
    "log.loot_retort": "a retort",
    "log.site_cleared": "The site is cleared: {things}",
    "log.site_cleared_empty": "The site is cleared",

    "log.saved": "Saved turn {turn} to {path}",
    "log.save_failed": "Save failed: {why}",
    "log.loaded": "Loaded turn {turn} from {path}",
    "log.load_failed": "Load failed: {why}",
    "log.undid": "Undid {what}",
    "log.nothing_to_undo": "Nothing to undo (ending a turn, discoveries and dice cannot be undone)",
    "log.turn": "Turn {turn}",
    "log.new_map": "New map, seed {seed}",
    "log.map_failed": "Map generation failed: {why}",
    "log.cast_cancelled": "Cast cancelled",
    "log.resign_question": "There are at least {turns} turns remaining until you may return. Do you wish to resign?",
    "log.resign_keys": "Y: resign      Enter: keep casting",
    "log.playing_as": "Playing as {race}",
    "log.farmers_balanced": "Farmers balanced to feed the army",
    "log.select_settlers": "Select settlers first",
    "log.not_in_game": "Not in the game yet",
}
