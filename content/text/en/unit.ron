// Player-facing messages of the unit sheet and the unit window. One key is in one file only (docs/text.md).
{
    "unit.dismiss": "Dismiss",
    "unit.moves": "Moves",
    "unit.damage": "Damage",
    "unit.melee": "Melee",
    "unit.range": "Range",
    "unit.armor": "Armor",
    "unit.resist": "Resist",
    "unit.hits": "Hits",
    "unit.disband": "Do you wish to disband the unit of {unit}?",
    "unit.dies_one": "  This unit will die if the spell is removed!",
    "unit.dies_many": "  This unit and other units will die if the spell is removed!",
    "unit.moves_whole": "Moves: {n}",
    "unit.moves_half": "Moves: {n}.5",
    // The abilities list: level, ammunition, to hit and the like.
    "unit.level": "{name} ({xp} ep)",
    "unit.quiver_rock": (count: "n", one: "Rock x{n}", other: "Rocks x{n}"),
    "unit.quiver_arrow": (count: "n", one: "Arrow x{n}", other: "Arrows x{n}"),
    "unit.quiver_bullet": (count: "n", one: "Bullet x{n}", other: "Bullets x{n}"),
    "unit.quiver_spell": (count: "n", one: "Spell x{n}", other: "Spells x{n}"),
    "unit.to_hit_plus": "+{n} To Hit",
    "unit.to_hit_minus": "{n} To Hit",
    "unit.construction": "Construction",
    "unit.scouting": "Scouting {n}",
    "unit.carries": "Carries {n}",
    "unit.caster": "Caster {n} mp",
    "unit.undead": "Undead",
}
