// Our own one-paragraph description of each building (the production screen shows it).
// One key is in one file only (docs/text.md).
{
    "building.barracks": "Trains regular soldiers. Units cannot be built here without it.",
    "building.armory": "Stores arms and armor. Lets the city build better equipped troops.",
    "building.fighters_guild": "Teaches basic fighting skills. New units start as regulars.",
    "building.armorers_guild": "Skilled armorers outfit the troops. New units start with more experience.",
    "building.war_college": "Teaches advanced tactics. New units start as veterans.",
    "building.smithy": "A forge for weapons and tools. Opens the way to better military and trade buildings.",
    "building.stables": "Raises and trains horses, so the city can field mounted troops.",
    "building.animists_guild": "Followers of nature calm the people, help the harvest and bring a little mana.",
    "building.fantastic_stable": "Keeps fantastic beasts, so the city can build the strongest mounts and monsters.",
    "building.ship_wrights_guild": "Builds simple ships for a city on the coast.",
    "building.ship_yard": "A larger dock for sturdier warships and trading vessels.",
    "building.maritime_guild": "The master of sea power: the biggest ships and the best crews.",
    "building.sawmill": "Turns timber into building material and raises the city's production by a quarter.",
    "building.library": "Books and scholars add to the city's research.",
    "building.sages_guild": "Learned sages add more research to the city.",
    "building.oracle": "Foretells the future: calms the people and lets the city see further.",
    "building.alchemists_guild": "Brews potions and refines metal. Lets the city make better equipment.",
    "building.university": "A seat of learning that greatly raises the city's research.",
    "building.wizards_guild": "Mages gather here to study. Raises research and gives the city mana.",
    "building.shrine": "A place of worship that calms the people and yields a little mana.",
    "building.temple": "A larger house of worship: calmer people and more mana.",
    "building.parthenon": "A grand monument to the divine. Soothes the people and gives more mana.",
    "building.cathedral": "The greatest house of worship. Soothes the people and gives the most mana.",
    "building.marketplace": "Traders gather here. Raises the city's gold by half.",
    "building.bank": "Lends and stores money. Raises the city's gold by another half.",
    "building.merchants_guild": "A guild of great traders. Doubles the city's base gold.",
    "building.granary": "Stores grain against bad times and speeds up growth.",
    "building.farmers_market": "Farmers sell their crops directly: more food and faster growth.",
    "building.foresters_guild": "Foresters tend the woods: more food and a quarter more production.",
    "building.builders_hall": "The base of all city works. Many other buildings need it first.",
    "building.mechanicians_guild": "Engineers build machines that raise the city's production by half.",
    "building.miners_guild": "Miners work the nearby hills and raise the city's production by half.",
    "building.city_walls": "Walls protect the city: attackers must cross them, and the city sees farther.",
}
