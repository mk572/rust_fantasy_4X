// Our own one-paragraph description of each building (the production screen shows it).
// One key is in one file only (docs/text.md).
{
    "building.barracks": "Lets the city train its regular soldiers.",
    "building.armory": "Lets the city build halberdiers (for most races) and halfling slingers.",
    "building.fighters_guild": "Teaches basic fighting skills.",
    "building.armorers_guild": "Skilled armorers outfit the troops.",
    "building.war_college": "Teaches advanced tactics.",
    "building.smithy": "A forge for weapons and tools. Opens the way to better military and trade buildings.",
    "building.stables": "Raises and trains horses, so the city can field mounted troops.",
    "building.animists_guild": "Followers of nature tend the city.",
    "building.fantastic_stable": "Keeps fantastic beasts, so the city can build the strongest mounts and monsters.",
    "building.ship_wrights_guild": "Builds simple ships for a city on the coast.",
    "building.ship_yard": "A larger dock for sturdier warships and trading vessels.",
    "building.maritime_guild": "The master of sea power: the biggest ships and the best crews.",
    "building.sawmill": "Turns timber into building material.",
    "building.library": "Books and scholars gather here.",
    "building.sages_guild": "Learned sages gather here.",
    "building.oracle": "Foretells the future.",
    "building.alchemists_guild": "Brews potions and refines metal: units built in the city get magic weapons, or mithril or adamantium when the city works such an ore.",
    "building.university": "A seat of learning.",
    "building.wizards_guild": "Mages gather here to study.",
    "building.shrine": "A place of worship.",
    "building.temple": "A larger house of worship.",
    "building.parthenon": "A grand monument to the divine.",
    "building.cathedral": "The greatest house of worship.",
    "building.marketplace": "Traders gather here.",
    "building.bank": "Lends and stores money.",
    "building.merchants_guild": "A guild of great traders.",
    "building.granary": "Stores grain against bad times.",
    "building.farmers_market": "Farmers sell their crops directly.",
    "building.foresters_guild": "Foresters tend the woods.",
    "building.builders_hall": "The base of all city works. Many other buildings need it first.",
    "building.mechanicians_guild": "Engineers build machines.",
    "building.miners_guild": "Miners work the nearby hills.",
    "building.city_walls": "In battle a wall rings the city: attackers can pass it only through the gate.",
