    [("Aldous Vane", Masculine), ("Brisa Quill", Feminine), ("Corvin Ashgrove", Masculine), ("Delphine Mourne", Feminine), ("Edric Thorne", Masculine), ("Fenwick Grail", Masculine), ("Galadra Stone", Feminine), ("Hestor Blight", Masculine), ("Ilyana Frost", Feminine), ("Jorund Pike", Masculine)],
    [("Kestrel Dusk", Masculine), ("Lisander Crow", Masculine), ("Morwen Gale", Feminine), ("Nerezza", Feminine), ("Orsino Black", Masculine), ("Pelagia Reed", Feminine), ("Quillon Marsh", Masculine), ("Rhosyn Hale", Feminine), ("Silvanus Thorn", Masculine), ("Talindra Voss", Feminine)],
    [("Ulric Fenn", Masculine), ("Vesperine", Feminine), ("Wystan Cole", Masculine), ("Xanthe Rook", Feminine), ("Yorick Dell", Masculine), ("Zephra Lund", Feminine), ("Ambrose Keld", Masculine), ("Belisarius Moor", Masculine), ("Cassiopeia Wren", Feminine), ("Dagonet Ash", Masculine)],
    [("Eluned Marsh", Feminine), ("Fabrizio Nox", Masculine), ("Gwendolen Flint", Feminine), ("Hadrian Veil", Masculine), ("Isolde Crane", Feminine), ("Jasper Holloway", Masculine), ("Kalliope Dross", Feminine), ("Leofric Brandt", Masculine), ("Mirabel Thane", Feminine), ("Nikodemos Hart", Masculine)],
